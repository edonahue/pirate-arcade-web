---
// Nautical chart decorative overlay — sparse rhumb-line bearings,
// partial compass rose, one X mark, and a small mermaid engraving.
// aria-hidden, pointer-events: none, responsive.
---

<svg
  class="chart-overlay"
  viewBox="0 0 1440 900"
  preserveAspectRatio="xMidYMid slice"
  aria-hidden="true"
  focusable="false"
>
  <!-- Rhumb lines (portolan-style bearings from two edge origins) -->
  <g class="chart-rhumb-lines">
    <line x1="120" y1="160" x2="600" y2="800"></line>
    <line x1="120" y1="160" x2="1100" y2="700"></line>
    <line x1="120" y1="160" x2="1400" y2="300"></line>
    <line x1="120" y1="160" x2="800" y2="900"></line>
    <line x1="800" y1="120" x2="200" y2="550"></line>
    <line x1="800" y1="120" x2="300" y2="780"></line>
    <line x1="800" y1="120" x2="1000" y2="850"></line>
    <line x1="800" y1="120" x2="1300" y2="650"></line>
  </g>

  <!-- Compass rose (partially off-screen top-right) -->
  <g class="compass-rose" transform="translate(1340, 30)">
    <!-- Outer 8-point star -->
    <polygon
      points="0,-140 28,-28 140,0 28,28 0,140 -28,28 -140,0 -28,-28"
      stroke="currentColor"
      stroke-width="1"
      fill="none"
      opacity="0.35"></polygon>
    <!-- Inner 8-point star -->
    <polygon
      points="0,-90 18,-18 90,0 18,18 0,90 -18,18 -90,0 -18,-18"
      stroke="currentColor"
      stroke-width="0.5"
      fill="none"
      opacity="0.25"></polygon>
    <!-- Cardinal points filled -->
    <polygon
      points="0,-140 14,-14 0,0 -14,-14"
      fill="currentColor"
      opacity="0.12"></polygon>
    <polygon points="0,140 14,14 0,0 -14,14" fill="currentColor" opacity="0.08"
    ></polygon>
    <polygon points="140,0 14,-14 0,0 14,14" fill="currentColor" opacity="0.08"
    ></polygon>
    <polygon
      points="-140,0 -14,-14 0,0 -14,14"
      fill="currentColor"
      opacity="0.08"></polygon>
    <!-- Labels -->
    <text
      x="0"
      y="-152"
      text-anchor="middle"
      font-family="serif"
      font-size="18"
      fill="currentColor"
      opacity="0.4">N</text
    >
    <text
      x="152"
      y="5"
      text-anchor="middle"
      font-family="serif"
      font-size="18"
      fill="currentColor"
      opacity="0.3">E</text
    >
    <text
      x="0"
      y="165"
      text-anchor="middle"
      font-family="serif"
      font-size="14"
      fill="currentColor"
      opacity="0.2">S</text
    >
    <text
      x="-152"
      y="5"
      text-anchor="middle"
      font-family="serif"
      font-size="14"
      fill="currentColor"
      opacity="0.2">W</text
    >
    <!-- Center dot -->
    <circle cx="0" cy="0" r="3" fill="currentColor" opacity="0.2"></circle>
  </g>

  <!-- X mark -->
  <g class="x-marks">
    <path class="x-mark--primary" d="M 370,340 L 395,365 M 395,340 L 370,365"
    ></path>
  </g>

  <!-- Mermaid glyph (map engraving style) -->
  <g class="mermaid-glyph" transform="translate(180, 210)" opacity="0.18">
    <!-- Head -->
    <circle
      cx="0"
      cy="-20"
      r="4.5"
      stroke="currentColor"
      fill="none"
      stroke-width="1.2"></circle>
    <!-- Hair flowing back -->
    <path
      d="M 3,-18 Q 14,-24 20,-16 Q 18,-10 10,-14"
      stroke="currentColor"
      fill="none"
      stroke-width="0.8"></path>
    <path
      d="M 4,-15 Q 12,-20 18,-12"
      stroke="currentColor"
      fill="none"
      stroke-width="0.6"></path>
    <!-- Torso -->
    <path
      d="M 0,-15 Q -4,-5 0,5 Q 4,15 0,25"
      stroke="currentColor"
      fill="none"
      stroke-width="1"></path>
    <!-- Arm reaching -->
    <path
      d="M 2,-8 Q 14,-10 18,-3"
      stroke="currentColor"
      fill="none"
      stroke-width="0.8"></path>
    <!-- Tail -->
    <path
      d="M 0,25 Q 8,35 12,42"
      stroke="currentColor"
      fill="none"
      stroke-width="1"></path>
    <path
      d="M 0,25 Q -8,35 -12,42"
      stroke="currentColor"
      fill="none"
      stroke-width="1"></path>
    <!-- Tail fluke (left) -->
    <path
      d="M -12,42 Q -20,46 -18,52 Q -14,50 -8,46"
      stroke="currentColor"
      fill="none"
      stroke-width="0.8"></path>
    <!-- Tail fluke (right) -->
    <path
      d="M 12,42 Q 20,46 18,52 Q 14,50 8,46"
      stroke="currentColor"
      fill="none"
      stroke-width="0.8"></path>
    <!-- Scale suggestions -->
    <path
      d="M -2,28 Q 0,31 2,28"
      stroke="currentColor"
      fill="none"
      stroke-width="0.5"></path>
    <path
      d="M -3,32 Q 0,35 3,32"
      stroke="currentColor"
      fill="none"
      stroke-width="0.5"></path>
    <path
      d="M -3,36 Q 0,39 3,36"
      stroke="currentColor"
      fill="none"
      stroke-width="0.5"></path>
  </g>
</svg>

<style>
  .chart-overlay {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    pointer-events: none;
    z-index: 0;
    color: var(--chart-line);
    overflow: hidden;
  }

  .chart-rhumb-lines {
    stroke: currentColor;
    stroke-width: 0.3;
    opacity: 0.15;
  }

  .x-marks {
    stroke: currentColor;
    stroke-width: 2.5;
    stroke-linecap: round;
    opacity: 0.35;
    fill: none;
  }

  /* Light theme: reduce chart intensity slightly */
  :root[data-theme="light"] .chart-overlay {
    color: var(--chart-line);
  }

  :root[data-theme="light"] .chart-rhumb-lines {
    opacity: 0.1;
  }

  /* Mobile: clean negative space instead of a reduced chart */
  @media (max-width: 480px) {
    .chart-overlay {
      display: none;
    }
  }

  /* Tablet: ensure compass rose and glyph stay clear of header/reading area */
  @media (min-width: 481px) and (max-width: 820px) {
    .compass-rose {
      opacity: 0.5;
    }

    .mermaid-glyph {
      opacity: 0.15;
    }
  }
</style>
