---
import { site } from "../data/profile";
---

<footer class="site-footer">
  <div class="site-shell site-footer__grid">
    <div>
      <span class="site-footer__col-label">Project</span>
      <p>
        {site.tagline}
      </p>
    </div>
    <div>
      <span class="site-footer__col-label">Made by</span>
      <p>
        <a href={site.authorUrl} target="_blank" rel="noopener noreferrer">
          {site.author}
        </a>
        {" \u2014 "}a side project and workbench experiment, not a commercial
        game studio.
      </p>
      <p>
        <a
          href="https://buymeacoffee.com/erichdonahue"
          target="_blank"
          rel="noopener noreferrer"
          class="support-link--footer"
        >
          Buy me a coffee
        </a>
      </p>
    </div>
    <div>
      <span class="site-footer__col-label">Find it on</span>
      <div class="site-footer__links">
        <a
          href="https://github.com/edonahue/pirate-arcade"
          target="_blank"
          rel="noopener noreferrer"
        >
          Desktop Repo
        </a>
        <a
          href="https://github.com/edonahue/pirate-arcade-web"
          target="_blank"
          rel="noopener noreferrer"
        >
          Website Repo
        </a>
      </div>
    </div>
    <div>
      <span class="site-footer__col-label">Art Credits</span>
      <p>
        Background illustrations by
        <a
          href="https://commons.wikimedia.org/wiki/Category:Howard_Pyle%27s_Book_of_Pirates_(1921)"
          target="_blank"
          rel="noopener noreferrer"
        >
          Howard Pyle
        </a>
        {" "}(public domain, from <em>Howard Pyle's Book of Pirates</em>, 1921).
      </p>
    </div>
  </div>
</footer>
