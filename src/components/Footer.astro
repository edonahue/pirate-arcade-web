---
import { site } from "../data/profile";
---

<footer class="site-footer">
  <div class="site-shell site-footer__grid">
    <div>
      <span class="site-footer__col-label">Project</span>
      <p>
        {site.tagline}
      </p>
    </div>
    <div>
      <span class="site-footer__col-label">Made by</span>
      <p>
        <a href={site.authorUrl} target="_blank" rel="noopener noreferrer">
          {site.author}
        </a>
        {" \u2014 "}
        <a href={site.personalSiteUrl} target="_blank" rel="noopener noreferrer"
          >erichdonahue.com</a
        >
        {" \u2014 "}
        <a href={site.githubUrl} target="_blank" rel="noopener noreferrer"
          >github/edonahue</a
        >
      </p>
    </div>
    <div>
      <span class="site-footer__col-label">Repositories</span>
      <div class="site-footer__links">
        <a href={site.desktopRepoUrl} target="_blank" rel="noopener noreferrer">
          Desktop Repo
        </a>
        <a href={site.websiteRepoUrl} target="_blank" rel="noopener noreferrer">
          Website Repo
        </a>
      </div>
    </div>
    <div>
      <span class="site-footer__col-label">Art Credits</span>
      <p>
        Illustrations by
        <a
          href="https://commons.wikimedia.org/wiki/Category:Howard_Pyle%27s_Book_of_Pirates_(1921)"
          target="_blank"
          rel="noopener noreferrer"
        >
          Howard Pyle
        </a>
        {" and "}
        <a
          href="https://en.wikipedia.org/wiki/Louis_Rhead"
          target="_blank"
          rel="noopener noreferrer"
        >
          Louis Rhead
        </a>
        {" "}(public domain).
      </p>
      <p class="mt-1">
        <a href="/credits/">Full asset credits &rarr;</a>
      </p>
    </div>
  </div>
</footer>
