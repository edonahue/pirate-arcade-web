---
import { games } from "../data/games";
import { ASSET_VERSION } from "../../scripts/game-asset-versions.mjs";
---

<section class="section status-panel">
  <div class="section__header">
    <p class="section__eyebrow">Compatibility</p>
    <h2 class="section__title">Status &amp; Controls</h2>
  </div>

  <div class="status-panel__table-wrapper">
    <table class="status-panel__table">
      <thead>
        <tr>
          <th>Game</th>
          <th>Play</th>
          <th>Load</th>
          <th>Keyboard</th>
          <th>Touch</th>
          <th>Audio</th>
        </tr>
      </thead>
      <tbody>
        {
          games.map((game) => (
            <tr>
              <td class="status-panel__game-name">
                <strong>{game.title}</strong>
                <span class="status-panel__classic">{game.classic}</span>
              </td>
              <td>
                {game.status === "browser-playable" ? (
                  <a
                    href={game.browserUrl!}
                    class="status-panel__play-link"
                    data-game-id={game.id}
                    data-game-title={game.title}
                    data-browser-playable="true"
                    data-game-page={game.browserUrl!}
                    data-game-archive={
                      game.engine === "pygbag"
                        ? `/play/${game.id}/${game.id}.tar.gz?v=${ASSET_VERSION}`
                        : ""
                    }
                    data-game-launch="true"
                    data-captains-log={game.id}
                  >
                    In browser
                  </a>
                ) : (
                  <a
                    href={game.desktopUrl!}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="status-panel__download-link"
                  >
                    Desktop
                  </a>
                )}
              </td>
              <td>
                {(() => {
                  if (game.engine === "phaser") return "Instant";
                  if (game.engine === "pygbag") return "~12 MB";
                  return "Install";
                })()}
              </td>
              <td>
                <span aria-label="Supported">✓</span>
              </td>
              <td>
                {game.status === "browser-playable" ? (
                  <span aria-label="Available">✓</span>
                ) : (
                  <span class="muted" aria-label="Not available">
                    —
                  </span>
                )}
              </td>
              <td>
                <span aria-label="Needs user gesture">
                  {game.status === "browser-playable"
                    ? "Tap to start"
                    : "Desktop-native"}
                </span>
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <p class="status-panel__footnote">
    Load: Pygbag games download a ~12 MB CPython runtime on first visit (cached
    on repeat). Web-native Phaser games load instantly. Desktop games require
    native install. Audio in browser games unlocks after first click or tap
    (autoplay policy). Mobile tested via simulated viewports — real device
    behavior may vary.
  </p>
</section>

<style>
  .status-panel__table-wrapper {
    overflow-x: auto;
    max-width: 640px;
    margin: 0 auto;
  }

  .status-panel__table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.875rem;
  }

  .status-panel__table th,
  .status-panel__table td {
    padding: 0.625rem 0.75rem;
    text-align: left;
    border-bottom: 1px solid var(--line);
  }

  .status-panel__table th {
    font-family: var(--mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--muted);
  }

  .status-panel__game-name {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }

  .status-panel__classic {
    font-family: var(--mono);
    font-size: 0.75rem;
    color: var(--muted);
  }

  .status-panel__play-link {
    font-family: var(--mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent);
    text-decoration: none;
    white-space: nowrap;
  }

  .status-panel__play-link:hover {
    text-decoration: underline;
  }

  .status-panel__play-link:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }

  .status-panel__download-link {
    font-family: var(--mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
    text-decoration: none;
    white-space: nowrap;
  }

  .status-panel__download-link:hover {
    color: var(--accent);
  }

  .status-panel__download-link:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }

  .status-panel__footnote {
    max-width: 560px;
    margin: 1.5rem auto 0;
    font-size: 0.75rem;
    color: var(--muted);
    text-align: center;
    line-height: 1.5;
  }

  @media (max-width: 640px) {
    .status-panel__table {
      font-size: 0.75rem;
    }

    .status-panel__table th,
    .status-panel__table td {
      padding: 0.5rem 0.5rem;
    }

    .status-panel__table th {
      font-size: 0.5625rem;
    }

    .status-panel__game-name {
      gap: 0.125rem;
    }

    .status-panel__classic {
      font-size: 0.625rem;
    }

    .status-panel__play-link,
    .status-panel__download-link {
      font-size: 0.625rem;
    }

    .status-panel__footnote {
      font-size: 0.6875rem;
      padding: 0 0.5rem;
    }
  }
</style>
