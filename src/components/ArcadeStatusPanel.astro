---
import { games } from "../data/games";
import {
  isBrowserPlayable,
  isDesktopAvailable,
  isPygbag,
  isWebNative,
  getBrowserLoadLabel,
  getBrowserEngineLabel,
  getChallengeLabel,
} from "../lib/gameLaunch";

const challengeLabels: Record<string, string> = {
  easier: "Easier",
  balanced: "Balanced",
  harder: "Harder",
};
---

<section class="section status-panel">
  <div class="section__header">
    <p class="section__eyebrow">Compatibility</p>
    <h2 class="section__title">Status &amp; Controls</h2>
  </div>

  <div class="status-panel__table-wrapper">
    <table class="status-panel__table">
      <thead>
        <tr>
          <th>Game</th>
          <th>Load</th>
          <th>Challenge</th>
          <th>Touch</th>
          <th>Audio</th>
        </tr>
      </thead>
      <tbody>
        {
          games.map((game) => (
            <tr>
              <td class="status-panel__game-name">
                <strong>{game.title}</strong>
                <span class="status-panel__classic">{game.classic}</span>
              </td>
<td>
  {getBrowserLoadLabel(game)?.text ?? "Install"}
</td>
              <td>{game.challenge ? challengeLabels[game.challenge] : "—"}</td>
<td>
  {isDesktopAvailable(game) ? "Desktop-native" : "Not available"}
</td>
<td>
  <span aria-label="Needs user gesture">
    {isBrowserPlayable(game) ? "Tap to start" : isDesktopAvailable(game) ? "Desktop-native" : "Not available"}
  </span>
</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <p class="status-panel__footnote">
    Load: Pygbag games load the Python game runtime on first visit (cached on
    repeat). Web-native Phaser games load instantly. Desktop games require
    native install. Audio in browser games unlocks after first click or tap
    (autoplay policy). Mobile tested via simulated viewports — real device
    behavior may vary.
  </p>
</section>

<style>
  .status-panel__table-wrapper {
    overflow-x: auto;
    max-width: 640px;
    margin: 0 auto;
  }

  .status-panel__table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.875rem;
  }

  .status-panel__table th,
  .status-panel__table td {
    padding: 0.625rem 0.75rem;
    text-align: left;
    border-bottom: 1px solid var(--line);
  }

  .status-panel__table th {
    font-family: var(--mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--muted);
  }

  .status-panel__game-name {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }

  .status-panel__classic {
    font-family: var(--mono);
    font-size: 0.75rem;
    color: var(--muted);
  }

  .status-panel__footnote {
    max-width: 560px;
    margin: 1.5rem auto 0;
    font-size: 0.75rem;
    color: var(--muted);
    text-align: center;
    line-height: 1.5;
  }

  @media (max-width: 640px) {
    .status-panel__table {
      font-size: 0.75rem;
    }

    .status-panel__table th,
    .status-panel__table td {
      padding: 0.5rem 0.5rem;
    }

    .status-panel__table th {
      font-size: 0.5625rem;
    }

    .status-panel__game-name {
      gap: 0.125rem;
    }

    .status-panel__classic {
      font-size: 0.625rem;
    }

    .status-panel__footnote {
      font-size: 0.6875rem;
      padding: 0 0.5rem;
    }
  }
</style>
