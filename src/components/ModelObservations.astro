---
import { modelRuns } from "../data/experiment";
---

<p class="model-obs__note">
  Observations are based on session notes and recollection, not controlled
  measurement. They capture what stood out during development rather than formal
  evaluation metrics.
</p>

<div class="model-obs-wrapper">
  <table class="model-obs-table">
    <thead>
      <tr>
        <th>Model</th>
        <th>Task</th>
        <th>Observations</th>
      </tr>
    </thead>
    <tbody>
      {
        modelRuns.map((run) => (
          <tr>
            <td class="model-obs-table__model">{run.model}</td>
            <td class="model-obs-table__task">{run.task}</td>
            <td>
              <ul class="model-obs-table__list">
                {run.observed.map((obs) => (
                  <li>{obs}</li>
                ))}
              </ul>
            </td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>

<style>
  .model-obs__note {
    max-width: 560px;
    margin: 0 auto 1.5rem;
    font-size: 0.8125rem;
    color: var(--muted);
    font-style: italic;
    text-align: center;
    line-height: 1.5;
  }

  .model-obs-wrapper {
    overflow-x: auto;
  }

  .model-obs-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.875rem;
  }

  .model-obs-table th,
  .model-obs-table td {
    padding: 0.75rem;
    text-align: left;
    border-bottom: 1px solid var(--line);
    vertical-align: top;
  }

  .model-obs-table th {
    font-family: var(--mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--muted);
  }

  .model-obs-table__model {
    font-weight: 600;
    white-space: nowrap;
  }

  .model-obs-table__task {
    font-style: italic;
    color: var(--ink);
  }

  .model-obs-table__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .model-obs-table__list li {
    font-size: 0.8125rem;
    color: var(--muted);
    line-height: 1.5;
    padding-left: 1rem;
    position: relative;
  }

  .model-obs-table__list li::before {
    content: "\25B8";
    position: absolute;
    left: 0;
    color: var(--accent);
  }

  @media (max-width: 640px) {
    .model-obs-table {
      font-size: 0.75rem;
    }

    .model-obs-table th,
    .model-obs-table td {
      padding: 0.5rem 0.5rem;
    }

    .model-obs-table th {
      font-size: 0.5625rem;
    }

    .model-obs-table__model {
      font-size: 0.8125rem;
    }

    .model-obs-table__task {
      font-size: 0.75rem;
    }

    .model-obs-table__list li {
      font-size: 0.75rem;
      padding-left: 0.75rem;
    }
  }
</style>
