---
import type { Game } from "../data/games";
import StatusBadge from "./StatusBadge.astro";

export interface Props {
  game: Game;
}

const { game } = Astro.props;
---

<article class="game-card">
  <a href={game.desktopUrl || "#"} class="game-card__image" aria-label={`${game.title} screenshot`}>
    {
      game.screenshot ? (
        <img src={game.screenshot} alt={`${game.title} screenshot`} loading="lazy" />
      ) : (
        <span>[{game.title} screenshot]</span>
      )
    }
  </a>
  <div class="game-card__body">
    <h3 class="game-card__title">
      <a href={game.desktopUrl || "#"}>{game.title}</a>
    </h3>
    <div class="game-card__classic">{game.classic}</div>
    <p class="game-card__description">{game.description}</p>
  </div>
  <div class="game-card__footer">
    <StatusBadge variant={game.status === "desktop-available" ? "available" : game.status === "browser-planned" ? "planned" : "experimental"} label={game.statusLabel} />
  </div>
</article>
