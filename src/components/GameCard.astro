---
import type { Game } from "../data/games";
import StatusBadge from "./StatusBadge.astro";
import { ASSET_VERSION } from "../../scripts/game-asset-versions.mjs";

export interface Props {
  game: Game;
}

const { game } = Astro.props;
const cardHref = `/games/${game.id}/`;
const isBrowserPlayable =
  game.status === "browser-playable" && !!game.browserUrl;
const engine = game.engine || "none";
const isPygbag = engine === "pygbag";
const isPhaserNative = engine === "phaser";
const linkId = `game-card-link-${game.id}`;
const browserUrl = isBrowserPlayable ? game.browserUrl! : "";
const archiveUrl = isPygbag
  ? `${browserUrl}${game.id}.tar.gz?v=${ASSET_VERSION}`
  : "";
const engineLabel = isPhaserNative ? "Phaser 3" : isPygbag ? "Pygbag" : null;
const touchDifficultyLabel = game.touchDifficulty
  ? {
      easy: "Easiest on touch",
      medium: "Medium on touch",
      harder: "Harder on touch",
    }[game.touchDifficulty]
  : null;
---

<article class="game-chart-frame">
  <div class="game-chart-frame__parchment">
    <div class="game-chart-frame__content">
      <a
        href={cardHref}
        class="game-card__image"
        aria-label={`${game.title} screenshot`}
        id={linkId}
        data-game-id={game.id}
        data-browser-playable={isBrowserPlayable}
        data-game-page={browserUrl}
        data-game-archive={archiveUrl}
      >
        {
          game.screenshot ? (
            <img
              src={game.screenshot}
              alt={`${game.title} screenshot`}
              loading="lazy"
              width="1280"
              height="720"
            />
          ) : (
            <span class="game-card__placeholder">
              [{game.title} screenshot]
            </span>
          )
        }
        {
          engineLabel && (
            <span class="game-card__engine-badge" data-engine={engine}>
              {engineLabel}
            </span>
          )
        }
      </a>
      <div class="game-card__body">
        <h3 class="game-card__title">
          <a href={cardHref}>{game.title}</a>
        </h3>
        <div class="game-card__classic">{game.classic}</div>
        <p class="game-card__description">{game.description}</p>
        {
          game.features && game.features.length > 0 && (
            <div class="game-card__features">
              {game.features.map((f) => (
                <span class="game-card__feature-chip">{f}</span>
              ))}
            </div>
          )
        }
      </div>
      <div class="game-card__footer">
        <div class="game-card__footer-badges">
          <StatusBadge
            variant={game.status === "desktop-available"
              ? "available"
              : game.status === "browser-playable"
                ? "available"
                : game.status === "browser-planned"
                  ? "planned"
                  : "experimental"}
            label={game.statusLabel}
            context="paper"
          />
          {
            game.touchDifficulty && touchDifficultyLabel && (
              <span
                class={`game-card__touch-difficulty game-card__touch-difficulty--${game.touchDifficulty}`}
              >
                {touchDifficultyLabel}
              </span>
            )
          }
        </div>
        {
          game.browserUrl && game.status === "browser-playable" && (
            <a
              href={game.browserUrl}
              class="game-card__play-link"
              data-game-id={game.id}
              data-browser-playable="true"
              data-game-page={browserUrl}
              data-game-archive={archiveUrl}
              data-captains-log={game.id}
            >
              Play in Browser →
            </a>
          )
        }
      </div>
    </div>
    <div class="game-chart-frame__brass-corner top-left"></div>
    <div class="game-chart-frame__brass-corner top-right"></div>
    <div class="game-chart-frame__brass-corner bottom-left"></div>
    <div class="game-chart-frame__brass-corner bottom-right"></div>
  </div>
</article>
