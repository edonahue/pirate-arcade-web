---
import type { Game } from "../data/games";
import StatusBadge from "./StatusBadge.astro";

export interface Props {
  game: Game;
}

const { game } = Astro.props;
const cardHref = `/games/${game.id}/`;
const isBrowserPlayable = game.status === "browser-playable" && game.browserUrl;
const linkId = `game-card-link-${game.id}`;
---

<article class="game-chart-frame">
  <div class="game-chart-frame__parchment">
    <div class="game-chart-frame__content">
      <a
        href={cardHref}
        class="game-card__image"
        aria-label={`${game.title} screenshot`}
        id={linkId}
        data-game-id={game.id}
        data-browser-playable={isBrowserPlayable}
      >
        {
          game.screenshot ? (
            <img
              src={game.screenshot}
              alt={`${game.title} screenshot`}
              loading="lazy"
              width="1280"
              height="720"
            />
          ) : (
            <span class="game-card__placeholder">
              [{game.title} screenshot]
            </span>
          )
        }
      </a>
      <div class="game-card__body">
        <h3 class="game-card__title">
          <a href={cardHref}>{game.title}</a>
        </h3>
        <div class="game-card__classic">{game.classic}</div>
        <p class="game-card__description">{game.description}</p>
        {
          game.features && game.features.length > 0 && (
            <div class="game-card__features">
              {game.features.map((f) => (
                <span class="game-card__feature-chip">{f}</span>
              ))}
            </div>
          )
        }
      </div>
      <div class="game-card__footer">
        <StatusBadge
          variant={game.status === "desktop-available"
            ? "available"
            : game.status === "browser-playable"
              ? "available"
              : game.status === "browser-planned"
                ? "planned"
                : "experimental"}
          label={game.statusLabel}
        />
        {
          game.browserUrl && game.status === "browser-playable" && (
            <a href={game.browserUrl} class="game-card__play-link">
              Play in Browser →
            </a>
          )
        }
      </div>
    </div>
    <div class="game-chart-frame__brass-corner top-left"></div>
    <div class="game-chart-frame__brass-corner top-right"></div>
    <div class="game-chart-frame__brass-corner bottom-left"></div>
    <div class="game-chart-frame__brass-corner bottom-right"></div>
  </div>
</article>

<script>
  let prewarmTimeout: ReturnType<typeof setTimeout> | null = null;

  function triggerGamePrewarm(gameId: string): void {
    if (prewarmTimeout) {
      clearTimeout(prewarmTimeout);
    }
    prewarmTimeout = setTimeout(() => {
      prewarmGameResources(gameId);
    }, 150);
  }

  function cancelGamePrewarm(): void {
    if (prewarmTimeout) {
      clearTimeout(prewarmTimeout);
      prewarmTimeout = null;
    }
  }

  function prewarmGameResources(gameId: string): void {
    if (!["cannonball-clash", "treasure-cove"].includes(gameId)) {
      return;
    }

    const baseUrl = `/play/${gameId}/`;
    const archiveUrl = `/play/${gameId}/${gameId}.tar.gz?v=mobile-v4`;

    prefetchPage(baseUrl);
    prefetchResource(archiveUrl, "fetch");
    warmServiceWorkerCache([baseUrl, archiveUrl]);
  }

  function prefetchPage(url: string): void {
    const link = document.createElement("link");
    link.rel = "prefetch";
    link.href = url;
    document.head.appendChild(link);
  }

  function prefetchResource(url: string, asType: string): void {
    const link = document.createElement("link");
    link.rel = "prefetch";
    link.href = url;
    if (asType) {
      link.as = asType;
    }
    document.head.appendChild(link);
  }

  function warmServiceWorkerCache(urls: string[]): void {
    if ("serviceWorker" in navigator && navigator.serviceWorker.controller) {
      navigator.serviceWorker.controller.postMessage({
        type: "WARM_CACHE",
        urls: urls,
      });
    }
  }

  // Attach prewarm event listeners via DOM data attributes
  const links = document.querySelectorAll<HTMLAnchorElement>(
    "a[data-game-id][data-browser-playable=true]",
  );
  links.forEach((link) => {
    const gameId = link.getAttribute("data-game-id")!;
    link.addEventListener("pointerenter", () => triggerGamePrewarm(gameId));
    link.addEventListener("pointerleave", () => cancelGamePrewarm());
    link.addEventListener("focus", () => triggerGamePrewarm(gameId));
    link.addEventListener("blur", () => cancelGamePrewarm());
    link.addEventListener(
      "touchstart",
      (e: Event) => {
        e.preventDefault();
        triggerGamePrewarm(gameId);
      },
      { passive: false },
    );
  });
</script>
