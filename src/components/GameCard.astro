---
import type { Game } from "../data/games";
import StatusBadge from "./StatusBadge.astro";

export interface Props {
  game: Game;
}

const { game } = Astro.props;
const cardHref = `/games/${game.id}/`;
const isBrowserPlayable = game.status === "browser-playable" && game.browserUrl;

// Prewarm functions with proper typing
let prewarmTimeout: ReturnType<typeof setTimeout> | null = null;

function triggerGamePrewarm(gameId: string) {
  // Clear any existing timeout
  if (prewarmTimeout) {
    clearTimeout(prewarmTimeout);
  }

  // Set a short delay to avoid prewarming on accidental hovers
  prewarmTimeout = setTimeout(() => {
    prewarmGameResources(gameId);
  }, 150); // 150ms delay
}

function cancelGamePrewarm(gameId: string) {
  if (prewarmTimeout) {
    clearTimeout(prewarmTimeout);
    prewarmTimeout = null;
  }
}

function prewarmGameResources(gameId: string) {
  // Only prewarm for browser-playable games
  if (!["cannonball-clash", "treasure-cove"].includes(gameId)) {
    return;
  }

  const baseUrl = `/play/${gameId}/`;
  const archiveUrl = `/play/${gameId}/${gameId}.tar.gz?v=mobile-v4`;

  // Prefetch the game HTML page
  prefetchPage(baseUrl);

  // Prefetch the game tarball
  prefetchResource(archiveUrl, "fetch");

  // Try to warm the service worker cache for same-origin assets
  warmServiceWorkerCache([baseUrl, archiveUrl]);
}

function prefetchPage(url: string) {
  const link = document.createElement("link");
  link.rel = "prefetch";
  link.href = url;
  document.head.appendChild(link);
}

function prefetchResource(url: string, asType: string) {
  const link = document.createElement("link");
  link.rel = "prefetch";
  link.href = url;
  if (asType) {
    link.as = asType;
  }
  document.head.appendChild(link);
}

function warmServiceWorkerCache(urls: string[]) {
  if ("serviceWorker" in navigator && navigator.serviceWorker.controller) {
    // Post a message to the service worker to warm cache for these URLs
    navigator.serviceWorker.controller.postMessage({
      type: "WARM_CACHE",
      urls: urls,
    });
  }
}
---

<article class="game-chart-frame">
  <div class="game-chart-frame__parchment">
    <div class="game-chart-frame__content">
      <a
        href={cardHref}
        class="game-card__image"
        aria-label={`${game.title} screenshot`}
        on:pointerenter={isBrowserPlayable
          ? (e) => triggerGamePrewarm(game.id)
          : undefined}
        on:pointerleave={isBrowserPlayable
          ? (e) => cancelGamePrewarm(game.id)
          : undefined}
        on:focus={isBrowserPlayable
          ? (e) => triggerGamePrewarm(game.id)
          : undefined}
        on:blur={isBrowserPlayable
          ? (e) => cancelGamePrewarm(game.id)
          : undefined}
        on:touchstart={isBrowserPlayable
          ? (e) => {
              e.preventDefault();
              triggerGamePrewarm(game.id);
            }
          : undefined}
      >
        {
          game.screenshot ? (
            <img
              src={game.screenshot}
              alt={`${game.title} screenshot`}
              loading="lazy"
              width="1280"
              height="720"
            />
          ) : (
            <span class="game-card__placeholder">
              [{game.title} screenshot]
            </span>
          )
        }
      </a>
      <div class="game-card__body">
        <h3 class="game-card__title">
          <a href={cardHref}>{game.title}</a>
        </h3>
        <div class="game-card__classic">{game.classic}</div>
        <p class="game-card__description">{game.description}</p>
        {
          game.features && game.features.length > 0 && (
            <div class="game-card__features">
              {game.features.map((f) => (
                <span class="game-card__feature-chip">{f}</span>
              ))}
            </div>
          )
        }
      </div>
      <div class="game-card__footer">
        <StatusBadge
          variant={game.status === "desktop-available"
            ? "available"
            : game.status === "browser-playable"
              ? "available"
              : game.status === "browser-planned"
                ? "planned"
                : "experimental"}
          label={game.statusLabel}
        />
        {
          game.browserUrl && game.status === "browser-playable" && (
            <a href={game.browserUrl} class="game-card__play-link">
              Play in Browser →
            </a>
          )
        }
      </div>
    </div>
    <div class="game-chart-frame__brass-corner top-left"></div>
    <div class="game-chart-frame__brass-corner top-right"></div>
    <div class="game-chart-frame__brass-corner bottom-left"></div>
    <div class="game-chart-frame__brass-corner bottom-right"></div>
  </div>
</article>

<script>
  let prewarmTimeout = null;

  function triggerGamePrewarm(gameId) {
    // Clear any existing timeout
    if (prewarmTimeout) {
      clearTimeout(prewarmTimeout);
    }

    // Set a short delay to avoid prewarming on accidental hovers
    prewarmTimeout = setTimeout(() => {
      prewarmGameResources(gameId);
    }, 150); // 150ms delay
  }

  function cancelGamePrewarm(gameId) {
    if (prewarmTimeout) {
      clearTimeout(prewarmTimeout);
      prewarmTimeout = null;
    }
  }

  function prewarmGameResources(gameId) {
    // Only prewarm for browser-playable games
    if (!["cannonball-clash", "treasure-cove"].includes(gameId)) {
      return;
    }

    const baseUrl = `/play/${gameId}/`;
    const archiveUrl = `/play/${gameId}/${gameId}.tar.gz?v=mobile-v4`;

    // Prefetch the game HTML page
    prefetchPage(baseUrl);

    // Prefetch the game tarball
    prefetchResource(archiveUrl, "fetch");

    // Try to warm the service worker cache for same-origin assets
    warmServiceWorkerCache([baseUrl, archiveUrl]);
  }

  function prefetchPage(url) {
    const link = document.createElement("link");
    link.rel = "prefetch";
    link.href = url;
    document.head.appendChild(link);
  }

  function prefetchResource(url, asType) {
    const link = document.createElement("link");
    link.rel = "prefetch";
    link.href = url;
    if (asType) {
      link.as = asType;
    }
    document.head.appendChild(link);
  }

  function warmServiceWorkerCache(urls) {
    if ("serviceWorker" in navigator && navigator.serviceWorker.controller) {
      // Post a message to the service worker to warm cache for these URLs
      navigator.serviceWorker.controller.postMessage({
        type: "WARM_CACHE",
        urls: urls,
      });
    }
  }
</script>
