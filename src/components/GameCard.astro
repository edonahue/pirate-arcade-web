---
import type { Game } from "../data/games";
import StatusBadge from "./StatusBadge.astro";
import {
  isBrowserPlayable,
  isPygbag,
  isWebNative,
  isDesktopAvailable,
  getArchiveUrl,
  getLaunchLinkAttrs,
  getBrowserLoadLabel,
  getBrowserEngineLabel,
  getChallengeLabel,
} from "../lib/gameLaunch";

export interface Props {
  game: Game;
}

const { game } = Astro.props;
const cardHref = `/games/${game.id}/`;
const playable = isBrowserPlayable(game);
const linkId = `game-card-link-${game.id}`;
const browserUrl = playable ? game.browserUrl! : "";
const archiveUrl = getArchiveUrl(game);
const engineLabel = getBrowserEngineLabel(game);
const loadLabel = getBrowserLoadLabel(game);
const challengeLabel = getChallengeLabel(game);
const screenshotCaption =
  loadLabel === "Instant"
    ? "Instant-load racer"
    : loadLabel === "Runtime load" && game.touchDifficulty === "easy"
      ? "Touch-friendly port"
      : loadLabel === "Runtime load" && game.touchDifficulty === "harder"
        ? "Touch-demanding survival"
        : loadLabel === "Runtime load"
          ? "Pygbag port"
          : "Desktop board game";
const touchDifficultyLabel = game.touchDifficulty
  ? {
      easy: "Easiest on touch",
      medium: "Medium on touch",
      harder: "Harder on touch",
    }[game.touchDifficulty]
  : null;
---

<article class="game-chart-frame">
  <div class="game-chart-frame__parchment">
    <div class="game-chart-frame__content">
      <a
        href={cardHref}
        class="game-card__image"
        aria-label={`${game.title} screenshot`}
        id={linkId}
        data-game-id={game.id}
        data-browser-playable={playable}
        data-game-page={browserUrl}
        data-game-archive={archiveUrl}
      >
        {
          game.screenshot ? (
            <img
              src={game.screenshot}
              alt={`${game.title} screenshot`}
              loading="lazy"
              width="1280"
              height="720"
            />
          ) : (
            <span class="game-card__placeholder">
              [{game.title} screenshot]
            </span>
          )
        }
        {
          engineLabel && (
            <span
              class="game-card__engine-badge"
              data-engine={game.engine ?? "none"}
            >
              {engineLabel}
            </span>
          )
        }
        <span class="game-card__screenshot-caption">{screenshotCaption}</span>
      </a>
      <div class="game-card__body">
        <h3 class="game-card__title">
          <a href={cardHref}>{game.title}</a>
        </h3>
        <div class="game-card__classic">{game.classic}</div>
        <p class="game-card__description">{game.description}</p>
        {
          game.firstPlayTip && (
            <p class="game-card__first-play">
              <span class="game-card__first-play-label">First play:</span>{" "}
              {game.firstPlayTip}
            </p>
          )
        }
        {
          game.features && game.features.length > 0 && (
            <div class="game-card__features">
              {game.features.map((f) => (
                <span class="game-card__feature-chip">{f}</span>
              ))}
            </div>
          )
        }
      </div>
      <div class="game-card__footer">
        <div class="game-card__footer-badges">
          <StatusBadge
            variant={isDesktopAvailable(game)
              ? "available"
              : game.status === "browser-playable"
                ? "available"
                : game.status === "browser-planned"
                  ? "planned"
                  : "experimental"}
            label={game.statusLabel}
            context="paper"
          />
          {
            game.touchDifficulty && touchDifficultyLabel && (
              <span
                class={`game-card__touch-difficulty game-card__touch-difficulty--${game.touchDifficulty}`}
              >
                {touchDifficultyLabel}
              </span>
            )
          }
          {
            playable && loadLabel && (
              <span
                class={`game-card__load-badge game-card__load-badge--${loadLabel === "Runtime load" ? "runtime" : "instant"}`}
              >
                {loadLabel}
              </span>
            )
          }
        </div>
        {
          playable && (
            <a class="game-card__play-link" {...getLaunchLinkAttrs(game)!}>
              Play in Browser →
            </a>
          )
        }
      </div>
    </div>
    <div class="game-chart-frame__brass-corner top-left"></div>
    <div class="game-chart-frame__brass-corner top-right"></div>
    <div class="game-chart-frame__brass-corner bottom-left"></div>
    <div class="game-chart-frame__brass-corner bottom-right"></div>
  </div>
</article>
