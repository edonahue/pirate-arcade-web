---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import GameCard from "../components/GameCard.astro";
import ArcadeFrame from "../components/ArcadeFrame.astro";
import ArcadeStatusPanel from "../components/ArcadeStatusPanel.astro";
import CaptainsLog from "../components/CaptainsLog.astro";
import CTAButton from "../components/CTAButton.astro";
import { games } from "../data/games";
import GameFinder from "../components/GameFinder.astro";
import { webPageNode } from "../lib/schema";
import {
  isBrowserPlayable,
  isPygbag,
  isWebNative,
  getArchiveUrl,
  getLaunchLinkAttrs,
} from "../lib/gameLaunch";

const browserGames = games.filter((g) => g.status === "browser-playable");
const pygbagGames = browserGames.filter((g) => g.engine === "pygbag");
const webNativeGames = browserGames.filter((g) => g.engine === "phaser");
const desktopGames = games.filter((g) => g.status === "desktop-available");

const browserEngineCount = new Set(browserGames.map((game) => game.engine))
  .size;

const getTouchLabel = (difficulty: string) => {
  switch (difficulty) {
    case "easy":
      return "Easiest on touch";
    case "medium":
      return "Medium on touch";
    case "harder":
      return "Harder on touch";
    default:
      return "";
  }
};

const instantGame = webNativeGames[0];
const easiestGame = browserGames.find((g) => g.touchDifficulty === "easy");
const classicGame = browserGames.find((g) => g.challenge === "balanced");
const harderGame = browserGames.find((g) => g.challenge === "harder");
const desktopGame = desktopGames[0];
---

<BaseLayout
  title="Play"
  description={`Play ${browserGames.length} pirate-themed arcade games in your browser now — including a web-native racer and ${pygbagGames.length} Pygbag/WebAssembly ports. No install required.`}
  current="play"
  jsonLd={[
    webPageNode(
      "/play/",
      "Play Pirate Arcade",
      `Play ${browserGames.length} pirate-themed arcade games in your browser now — including a web-native racer and ${pygbagGames.length} Pygbag/WebAssembly ports. No install required.`,
      "CollectionPage",
    ),
  ]}
>
  <Hero
    title="THE ARCADE"
    subtitle={`Pirate-themed arcade games. ${browserGames.length} games are playable in your browser now —
    including the web-native Race to Treasure Island. ${desktopGames.length} ${desktopGames.length === 1 ? "game is" : "games are"} desktop-only.`}
    eyebrow="Find Your Game"
    backgroundImage="/images/art/pyle-blackbeard-buries-treasure.webp"
    artPosition="50% 45%"
  >
    <CTAButton href={instantGame.browserUrl!} variant="primary">
      Play Instantly: {instantGame.title}
    </CTAButton>
    <CTAButton href="#start-here" variant="outline"> Help Me Choose </CTAButton>
  </Hero>

  <section class="section" id="start-here">
    <div class="section__header">
      <p class="section__eyebrow">Start here</p>
      <h2 class="section__title">Not Sure What to Play?</h2>
      <p class="section__description">
        Pick based on load time, touch difficulty, or arcade style.
      </p>
    </div>
    <GameFinder games={browserGames} />
    <div class="recommended-path">
      {
        instantGame && (
          <div class="recommended-path__item">
            <span class="recommended-path__label">Instant load</span>
            <a
              class="recommended-path__link"
              {...getLaunchLinkAttrs(instantGame)!}
            >
              {instantGame.title}
            </a>
            <span class="recommended-path__desc">{instantGame.bestFor}</span>
          </div>
        )
      }
      {
        easiestGame && (
          <div class="recommended-path__item">
            <span class="recommended-path__label">Best on touch</span>
            <a
              class="recommended-path__link"
              {...getLaunchLinkAttrs(easiestGame)!}
            >
              {easiestGame.title}
            </a>
            <span class="recommended-path__desc">{easiestGame.bestFor}</span>
          </div>
        )
      }
      {
        classicGame && (
          <div class="recommended-path__item">
            <span class="recommended-path__label">Classic challenge</span>
            <a
              class="recommended-path__link"
              {...getLaunchLinkAttrs(classicGame)!}
            >
              {classicGame.title}
            </a>
            <span class="recommended-path__desc">{classicGame.bestFor}</span>
          </div>
        )
      }
      {
        harderGame && (
          <div class="recommended-path__item">
            <span class="recommended-path__label">Harder skill</span>
            <a
              class="recommended-path__link"
              {...getLaunchLinkAttrs(harderGame)!}
            >
              {harderGame.title}
            </a>
            <span class="recommended-path__desc">{harderGame.bestFor}</span>
          </div>
        )
      }
      {
        desktopGame && (
          <div class="recommended-path__item">
            <span class="recommended-path__label">Desktop collection</span>
            <a href="#desktop-collection" class="recommended-path__link">
              {desktopGame.title} &amp; downloads
            </a>
            <span class="recommended-path__desc">
              Desktop-only strategy and game downloads.
            </span>
          </div>
        )
      }
    </div>
  </section>

  <section class="section" id="game-selection">
    <ArcadeFrame label="Game selection" topLabel="GAME SELECT  -  COURSE READY">
      <div class="game-selection__inner">
        <h2 class="sr-only">Available Games</h2>
        <div class="game-grid">
          {games.map((game) => <GameCard game={game} />)}
        </div>
      </div>
    </ArcadeFrame>
  </section>

  <section class="section" id="browser-games">
    <div class="section__header">
      <p class="section__eyebrow">Browser</p>
      <h2 class="section__title">Play Now</h2>
      <p class="section__description">
        {browserGames.length} browser-playable game{
          browserGames.length !== 1 ? "s" : ""
        } across {browserEngineCount} engine type{
          browserEngineCount !== 1 ? "s" : ""
        }: {pygbagGames.length}
        Pygbag/WebAssembly port{pygbagGames.length !== 1 ? "s" : ""} and {
          webNativeGames.length
        } web-native Phaser
        {webNativeGames.length === 1 ? "game" : "games"}. All {
          browserGames.length
        } are playable right now.
      </p>
    </div>

    <div class="engine-split">
      <div class="engine-card" id="pygbag-games">
        <div class="engine-card__header">
          <span
            class="engine-card__marker engine-card__marker--python"
            aria-hidden="true">PY</span
          >
          <h3 class="engine-card__title">Pygbag / WebAssembly</h3>
        </div>
        <p class="engine-card__desc">
          Python games compiled to WebAssembly. ~12 MB CPython runtime downloads
          once on first visit; repeat visits load from cache. Audio unlocks
          after first click.
        </p>
        <ul class="engine-card__games">
          {
            pygbagGames.map((game) => (
              <li>
                <a {...getLaunchLinkAttrs(game)!}>{game.title}</a>
                <span
                  class={
                    "engine-card__tag touch-" +
                    (game.touchDifficulty ?? "medium")
                  }
                >
                  {getTouchLabel(game.touchDifficulty ?? "medium")}
                </span>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="engine-card" id="web-native-games">
        <div class="engine-card__header">
          <span
            class="engine-card__marker engine-card__marker--javascript"
            aria-hidden="true">JS</span
          >
          <h3 class="engine-card__title">Web Native (Phaser)</h3>
        </div>
        <p class="engine-card__desc">
          JavaScript game built with Phaser. Loads instantly — no runtime
          download. Seeded obstacle courses, deterministic AI, and real-time
          wind boost mechanics.
        </p>
        <ul class="engine-card__games">
          {
            webNativeGames.map((game) => (
              <li>
                <a {...getLaunchLinkAttrs(game)!}>{game.title}</a>
                <span
                  class={
                    "engine-card__tag touch-" +
                    (game.touchDifficulty ?? "medium")
                  }
                >
                  {getTouchLabel(game.touchDifficulty ?? "medium")}
                </span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <div class="before-launch mt-4">
    <div class="before-launch__inner">
      <p class="before-launch__heading">Before you launch</p>
      <ul class="before-launch__list">
        <li>
          <strong>Pygbag games:</strong> ~12 MB first-visit download (cached on repeat).
        </li>
        <li>
          <strong>Web-native games:</strong> Load instantly — no runtime needed.
        </li>
        <li>
          <strong>Audio:</strong> Starts after your first click or tap.
        </li>
        <li>
          <strong>Controls:</strong> Keyboard works best. On-screen touch controls
          also available.
        </li>
        <li>
          <strong>Orientation:</strong> Landscape recommended.
        </li>
      </ul>
    </div>
  </div>

  <ArcadeStatusPanel />

  <section class="section" id="desktop-collection">
    <div class="section__header">
      <p class="section__eyebrow">Desktop</p>
      <h2 class="section__title">Desktop Collection</h2>
      <p class="section__description">
        The {pygbagGames.length} Pygbag game{
          pygbagGames.length !== 1 ? "s" : ""
        } ({pygbagGames.map((g) => g.title).join(", ")}) are also available as
        desktop downloads via the desktop repo. Race to Treasure Island is
        web-native and has no desktop build. Port Royale Tycoon is the only
        desktop-only game (see roadmap below).
      </p>
    </div>

    <div class="text-center mt-2">
      <a
        href="https://github.com/edonahue/pirate-arcade/releases"
        target="_blank"
        rel="noopener noreferrer"
        class="cta cta--gold"
      >
        Download Latest Release
      </a>
    </div>

    <div class="release-details mt-2">
      <div class="release-details__grid">
        <div class="release-details__item">
          <span class="release-details__label">Windows</span>
          <span class="release-details__value">Standalone .exe</span>
        </div>
        <div class="release-details__item">
          <span class="release-details__label">Linux</span>
          <span class="release-details__value">.deb package</span>
        </div>
        <div class="release-details__item">
          <span class="release-details__label">macOS</span>
          <span class="release-details__value">Build from source</span>
        </div>
        <div class="release-details__item">
          <span class="release-details__label">Source</span>
          <span class="release-details__value">MIT license</span>
        </div>
      </div>
      <p class="release-details__note">
        <a href="/build-log/launching-on-free-infrastructure">
          Read about the infrastructure
        </a>
        {" \u2014 "}how everything ships on free tiers.
      </p>
    </div>
  </section>

  <section class="section" id="roadmap">
    <div class="section__header">
      <p class="section__eyebrow">Roadmap</p>
      <h2 class="section__title">What's Next</h2>
      <p class="section__description">
        <strong>Race to Treasure Island</strong> is our first web-native (Phaser)
        game — load it instantly, no runtime download. Port Royale Tycoon (trading
        board game) remains the only desktop-only game. A browser port has been evaluated
        — see the feasibility review in the build log.
      </p>
      <p class="section__description mt-1">
        <a href="/build-log/browser-port-feasibility">
          Read the feasibility analysis
        </a>
        {" \u2014 "}Pygbag vs Canvas rewrite trade-offs.
      </p>
    </div>
  </section>

  <CaptainsLog games={games} />

  <script is:inline>
    if (!window.__paGamePrewarmInstalled) {
      window.__paGamePrewarmInstalled = true;

      /** @type {Map<string, {timeout: number|null, prefetchedUrls: Set<string>}>} */
      var prewarmState = new Map();

      function triggerGamePrewarm(gameId, pageUrl, archiveUrl) {
        var state = prewarmState.get(gameId);
        if (!state) {
          state = { timeout: null, prefetchedUrls: new Set() };
          prewarmState.set(gameId, state);
        }
        if (state.timeout) clearTimeout(state.timeout);
        state.timeout = setTimeout(function () {
          var urls = [pageUrl];
          // One warming owner per URL: if a SW controller is present,
          // use WARM_CACHE (no DOM prefetch). Otherwise use DOM prefetch.
          var hasController =
            "serviceWorker" in navigator && navigator.serviceWorker.controller;
          if (hasController) {
            if (archiveUrl) urls.push(archiveUrl);
            navigator.serviceWorker.controller.postMessage({
              type: "WARM_CACHE",
              urls: urls,
            });
          } else {
            if (!state.prefetchedUrls.has(pageUrl)) {
              var link = document.createElement("link");
              link.rel = "prefetch";
              link.href = pageUrl;
              document.head.appendChild(link);
              state.prefetchedUrls.add(pageUrl);
            }
            if (archiveUrl && !state.prefetchedUrls.has(archiveUrl)) {
              var link = document.createElement("link");
              link.rel = "prefetch";
              link.href = archiveUrl;
              link.as = "fetch";
              document.head.appendChild(link);
              state.prefetchedUrls.add(archiveUrl);
            }
          }
        }, 150);
      }

      function cancelGamePrewarm(gameId) {
        var state = prewarmState.get(gameId);
        if (state && state.timeout) {
          clearTimeout(state.timeout);
          state.timeout = null;
        }
      }

      var isDesktop = window.matchMedia("(pointer: fine)").matches;

      // Prewarming applies to all browser-game links (detail + launch)
      var allLinks = document.querySelectorAll(
        "a[data-game-id][data-browser-playable=true]",
      );
      allLinks.forEach(function (link) {
        link.addEventListener("pointerenter", function () {
          var gameId = link.getAttribute("data-game-id");
          var pageUrl = link.getAttribute("data-game-page");
          var archiveUrl = link.getAttribute("data-game-archive");
          if (gameId && pageUrl) {
            triggerGamePrewarm(gameId, pageUrl, archiveUrl);
          }
        });
        link.addEventListener("pointerleave", function () {
          var gameId = link.getAttribute("data-game-id");
          if (gameId) {
            cancelGamePrewarm(gameId);
          }
        });
        link.addEventListener("focus", function () {
          var gameId = link.getAttribute("data-game-id");
          var pageUrl = link.getAttribute("data-game-page");
          var archiveUrl = link.getAttribute("data-game-archive");
          if (gameId && pageUrl) {
            triggerGamePrewarm(gameId, pageUrl, archiveUrl);
          }
        });
        link.addEventListener(
          "touchstart",
          function () {
            var gameId = link.getAttribute("data-game-id");
            var pageUrl = link.getAttribute("data-game-page");
            var archiveUrl = link.getAttribute("data-game-archive");
            if (gameId && pageUrl) {
              triggerGamePrewarm(gameId, pageUrl, archiveUrl);
            }
          },
          { passive: true },
        );
        link.addEventListener("blur", function () {
          var gameId = link.getAttribute("data-game-id");
          if (gameId) {
            cancelGamePrewarm(gameId);
          }
        });
      });

      // Launch behavior only for actual launch links
      var launchLinks = document.querySelectorAll("a[data-game-launch=true]");
      launchLinks.forEach(function (link) {
        // Captain's Log: record launch on click (before navigation)
        // Desktop target/rel initialization outside click as before
        if (isDesktop) {
          link.setAttribute("target", "_blank");
          link.setAttribute("rel", "noopener noreferrer");
        }
        link.addEventListener("click", function () {
          var gameId = link.getAttribute("data-game-id");
          var pageUrl = link.getAttribute("data-game-page");
          var title = link.getAttribute("data-game-title");
          var captainsLogId = link.getAttribute("data-captains-log");

          if (captainsLogId) {
            if (window.__paCaptainsLog && window.__paCaptainsLog.addEntry) {
              window.__paCaptainsLog.addEntry(
                captainsLogId,
                title || gameId || "",
                pageUrl || "",
              );
              window.__paCaptainsLog.incrementLaunchCount(captainsLogId);
            }
          }
        });
      });
    }
  </script>

  <style>
    #game-selection,
    #browser-games,
    #pygbag-games,
    #web-native-games,
    #desktop-collection,
    #roadmap,
    #captains-log {
      scroll-margin-top: 5.5rem;
    }

    .game-selection__inner {
      padding: 1.5rem;
    }

    @media (max-width: 640px) {
      .game-selection__inner {
        padding: 1rem;
      }
    }

    .engine-split {
      display: grid;
      grid-template-columns: 1fr;
      gap: 1.25rem;
      max-width: 680px;
      margin: 0 auto 2rem;
    }

    .engine-card {
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: var(--radius-lg);
      padding: 1.5rem;
    }

    @media (max-width: 640px) {
      .engine-card {
        padding: 1rem;
      }

      .engine-card__desc {
        font-size: 0.8125rem;
      }

      .engine-card__games li {
        font-size: 0.8125rem;
      }

      .engine-card__tag {
        font-size: 0.5625rem;
        padding: 0.1rem 0.3rem;
      }
    }

    .engine-card:first-child {
      border-left: 3px solid var(--gold);
    }

    .engine-card:last-child {
      border-left: 3px solid var(--sea);
    }

    .engine-card__header {
      display: flex;
      align-items: center;
      gap: 0.625rem;
      margin-bottom: 0.75rem;
    }

    .engine-card__marker {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 2rem;
      height: 2rem;
      font-family: var(--mono);
      font-size: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      border: 1px solid currentColor;
      border-radius: 4px;
      flex-shrink: 0;
    }

    .engine-card__marker--python {
      color: var(--gold);
    }

    .engine-card__marker--javascript {
      color: var(--sea);
    }

    .engine-card__title {
      font-family: var(--display);
      font-size: 1.125rem;
      color: var(--ink);
    }

    .engine-card__desc {
      font-size: 0.875rem;
      color: var(--muted);
      line-height: 1.6;
      margin-bottom: 1rem;
    }

    .engine-card__games {
      list-style: none;
      padding: 0;
      margin: 0;
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
    }

    .engine-card__games li {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.875rem;
    }

    .engine-card__games a {
      color: var(--accent);
      text-decoration: underline;
      text-underline-offset: 2px;
    }

    .engine-card__games a:hover {
      color: var(--ink);
    }

    .engine-card__tag {
      font-family: var(--mono);
      font-size: 0.625rem;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      padding: 0.125rem 0.375rem;
      border: 1px solid currentColor;
      border-radius: 3px;
      white-space: nowrap;
    }

    .engine-card__tag.touch-easy {
      color: var(--sea);
    }

    .engine-card__tag.touch-medium {
      color: var(--gold);
    }

    .engine-card__tag.touch-harder {
      color: #d46040;
    }

    :global(:root[data-theme="light"]) .engine-card__tag.touch-harder {
      color: var(--rum);
    }

    @media (min-width: 640px) {
      .engine-split {
        grid-template-columns: 1fr 1fr;
        max-width: 780px;
      }
    }

    .before-launch {
      max-width: 580px;
      margin-left: auto;
      margin-right: auto;
    }

    .before-launch__inner {
      padding: 1.25rem 1.5rem;
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: var(--radius-lg);
      border-left: 3px solid var(--accent);
    }

    @media (max-width: 640px) {
      .before-launch__inner {
        padding: 1rem 1rem;
      }

      .before-launch__heading {
        font-size: 0.625rem;
      }

      .before-launch__list li {
        font-size: 0.75rem;
        padding-left: 0.75rem;
      }
    }

    .before-launch__heading {
      font-family: var(--mono);
      font-size: 0.6875rem;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      color: var(--accent);
      margin-bottom: 0.75rem;
    }

    .before-launch__list {
      list-style: none;
      padding: 0;
      margin: 0;
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
    }

    .before-launch__list li {
      font-size: 0.8125rem;
      color: var(--muted);
      line-height: 1.5;
      padding-left: 1rem;
      position: relative;
    }

    .before-launch__list li::before {
      content: "\25B8";
      position: absolute;
      left: 0;
      color: var(--accent);
    }

    .before-launch__list li strong {
      color: var(--ink);
    }

    .release-details__note a,
    .section__description a {
      text-decoration: underline;
      text-underline-offset: 2px;
    }
  </style>

  <script is:inline src="/scripts/captains-log.js"></script>
</BaseLayout>
