---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import GameCard from "../components/GameCard.astro";
import ArcadeFrame from "../components/ArcadeFrame.astro";
import ArcadeStatusPanel from "../components/ArcadeStatusPanel.astro";
import CaptainsLog from "../components/CaptainsLog.astro";
import { games } from "../data/games";
import { webPageNode } from "../lib/schema";
import { ASSET_VERSION } from "../../scripts/game-asset-versions.mjs";

const browserGames = games.filter((g) => g.status === "browser-playable");
const desktopGames = games.filter((g) => g.status === "desktop-available");
---

<BaseLayout
  title="Play"
  description="Choose your game from the Pirate Arcade collection. Desktop apps available now; three browser ports are live."
  current="play"
  jsonLd={[
    webPageNode(
      "/play/",
      "Play Pirate Arcade",
      "Choose your game from the Pirate Arcade collection. Desktop apps available now; three browser ports are live.",
      "CollectionPage",
    ),
  ]}
>
  <Hero
    title="THE ARCADE"
    subtitle="Pirate-themed arcade games. Cannonball Clash, Treasure Cove, and Kraken's Wake
    are playable in your browser now. Desktop downloads available for all four games."
    eyebrow="Play the Games"
  />

  <section class="section">
    <ArcadeFrame label="Game selection" topLabel="GAME SELECT  -  P1 READY">
      <div style="padding: 1.5rem;">
        <h2 class="sr-only">Available Games</h2>
        <div class="game-grid">
          {games.map((game) => <GameCard game={game} />)}
        </div>
      </div>
    </ArcadeFrame>
  </section>

  <section class="section">
    <div class="section__header">
      <p class="section__eyebrow">Browser</p>
      <h2 class="section__title">Play Now</h2>
      <p class="section__description">
        {browserGames.length} browser-playable games available. Pygbag games load
        a ~12 MB CPython runtime on first visit (cached on repeat visits). Web-native
        games load instantly. Audio unlocks after the first click or tap.
      </p>
    </div>

    <div class="play-status">
      <span class="play-status__item">
        <span class="play-status__count">{browserGames.length}</span>
        browser-ready
      </span>
      <span class="play-status__item play-status__item--muted">
        {desktopGames.length} desktop-only
      </span>
      <span class="play-status__repeat">
        Pygbag games: ~12 MB first visit (cached). Web-native games: instant
        load.
      </span>
    </div>

    <div class="play-now__ctas">
      {
        browserGames.map((game) => (
          <div class="text-center mt-2">
            <a
              href={game.browserUrl!}
              rel="noopener noreferrer"
              class="cta cta--primary"
              data-game-id={game.id}
              data-browser-playable="true"
              data-game-page={game.browserUrl!}
              data-game-archive={`/play/${game.id}/${game.id}.tar.gz?v=${ASSET_VERSION}`}
              data-captains-log={game.id}
            >
              Play {game.title}
            </a>
          </div>
        ))
      }
    </div>

    <div class="before-launch mt-4">
      <div class="before-launch__inner">
        <p class="before-launch__heading">Before you launch</p>
        <ul class="before-launch__list">
          <li>
            <strong>Pygbag games:</strong> ~12 MB CPython runtime downloads once on
            first visit — repeat visits load from cache.
          </li>
          <li>
            <strong>Web-native games:</strong> Load instantly via Phaser/Vite — no
            runtime download needed.
          </li>
          <li>
            <strong>Audio:</strong> Starts after your first click or tap (browser
            autoplay policy).
          </li>
          <li>
            <strong>Controls:</strong> Keyboard works best. On-screen touch controls
            available on mobile and iPad.
          </li>
          <li>
            <strong>Orientation:</strong> Landscape recommended for the best experience.
          </li>
        </ul>
        <p class="before-launch__footnote">
          <strong>On iPad:</strong> turn the device sideways. Pygbag games take longer
          on first load; repeat visits are fast. Race to Treasure Island is web-native
          and loads instantly.
        </p>
      </div>
    </div>

    <div class="touch-controls-summary mt-4">
      <h3 class="touch-controls-summary__title">Touch controls at a glance</h3>
      <div class="touch-controls-summary__grid">
        <div class="touch-controls-summary__card">
          <span class="touch-controls-summary__label">Cannonball Clash</span>
          <span class="touch-controls-summary__controls"
            >Slide ship up/down • START • PAUSE</span
          >
        </div>
        <div class="touch-controls-summary__card">
          <span class="touch-controls-summary__label">Treasure Cove</span>
          <span class="touch-controls-summary__controls"
            >Slide longboat left/right • LAUNCH • PAUSE</span
          >
        </div>
        <div class="touch-controls-summary__card">
          <span class="touch-controls-summary__label">Kraken's Wake</span>
          <span class="touch-controls-summary__controls"
            >TURN • THRUST • FIRE • PAUSE</span
          >
        </div>
      </div>
    </div>
  </section>

  <ArcadeStatusPanel />

  <section class="section">
    <div class="section__header">
      <p class="section__eyebrow">Desktop</p>
      <h2 class="section__title">Desktop Collection</h2>
      <p class="section__description">
        All four games are available as desktop downloads. Port Royale Tycoon is
        the only desktop-only game (see roadmap below).
      </p>
    </div>

    <div class="text-center mt-2">
      <a
        href="https://github.com/edonahue/pirate-arcade/releases"
        target="_blank"
        rel="noopener noreferrer"
        class="cta cta--gold"
      >
        Download Latest Release
      </a>
    </div>

    <div class="release-details mt-2">
      <div class="release-details__grid">
        <div class="release-details__item">
          <span class="release-details__label">Windows</span>
          <span class="release-details__value">Standalone .exe</span>
        </div>
        <div class="release-details__item">
          <span class="release-details__label">Linux</span>
          <span class="release-details__value">.deb package</span>
        </div>
        <div class="release-details__item">
          <span class="release-details__label">macOS</span>
          <span class="release-details__value">Build from source</span>
        </div>
        <div class="release-details__item">
          <span class="release-details__label">Source</span>
          <span class="release-details__value">MIT license</span>
        </div>
      </div>
      <p class="release-details__note">
        <a href="/build-log/launching-on-free-infrastructure">
          Read about the infrastructure
        </a>
        {" \u2014 "}how everything ships on free tiers.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="section__header">
      <p class="section__eyebrow">Roadmap</p>
      <h2 class="section__title">What's Next</h2>
      <p class="section__description">
        <strong>Race to Treasure Island</strong> is our first web-native (Phaser)
        game — load it instantly, no runtime download. Port Royale Tycoon (trading
        board game) remains the only desktop-only game. A browser port has been evaluated
        — see the feasibility review in the build log.
      </p>
      <p class="section__description mt-1">
        <a href="/build-log/browser-port-feasibility">
          Read the feasibility analysis
        </a>
        {" \u2014 "}Pygbag vs Canvas rewrite trade-offs.
      </p>
    </div>
  </section>

  <CaptainsLog games={games} />
</BaseLayout>

<script define:vars={{ ASSET_VERSION }} is:inline>
  if (!window.__paGamePrewarmInstalled) {
    window.__paGamePrewarmInstalled = true;

    /** @type {Map<string, {timeout: number|null, prefetchedUrls: Set<string>}>} */
    var prewarmState = new Map();

    function triggerGamePrewarm(gameId, pageUrl, archiveUrl) {
      var state = prewarmState.get(gameId);
      if (!state) {
        state = { timeout: null, prefetchedUrls: new Set() };
        prewarmState.set(gameId, state);
      }
      if (state.timeout) clearTimeout(state.timeout);
      state.timeout = setTimeout(function () {
        if (!state.prefetchedUrls.has(pageUrl)) {
          var link = document.createElement("link");
          link.rel = "prefetch";
          link.href = pageUrl;
          document.head.appendChild(link);
          state.prefetchedUrls.add(pageUrl);
        }
        if (!state.prefetchedUrls.has(archiveUrl)) {
          var link = document.createElement("link");
          link.rel = "prefetch";
          link.href = archiveUrl;
          link.as = "fetch";
          document.head.appendChild(link);
          state.prefetchedUrls.add(archiveUrl);
        }
        if (
          "serviceWorker" in navigator &&
          navigator.serviceWorker.controller
        ) {
          navigator.serviceWorker.controller.postMessage({
            type: "WARM_CACHE",
            urls: [pageUrl, archiveUrl],
          });
        }
      }, 150);
    }

    function cancelGamePrewarm(gameId) {
      var state = prewarmState.get(gameId);
      if (state && state.timeout) {
        clearTimeout(state.timeout);
        state.timeout = null;
      }
    }

    var isDesktop = window.matchMedia("(pointer: fine)").matches;
    var links = document.querySelectorAll(
      "a[data-game-id][data-browser-playable=true]",
    );
    links.forEach(function (link) {
      // Open in new tab on desktop (fine pointer); same tab on mobile (coarse pointer)
      if (isDesktop) {
        link.setAttribute("target", "_blank");
      }
      var gameId = link.getAttribute("data-game-id");
      var pageUrl = link.getAttribute("data-game-page") || "";
      var archiveUrl = link.getAttribute("data-game-archive") || "";
      var captainsLogId = link.getAttribute("data-captains-log");
      if (!pageUrl || !archiveUrl) return;

      link.addEventListener("pointerenter", function () {
        triggerGamePrewarm(gameId, pageUrl, archiveUrl);
      });
      link.addEventListener("pointerleave", function () {
        cancelGamePrewarm(gameId);
      });
      link.addEventListener("focus", function () {
        triggerGamePrewarm(gameId, pageUrl, archiveUrl);
      });
      link.addEventListener("blur", function () {
        cancelGamePrewarm(gameId);
      });
      link.addEventListener(
        "touchstart",
        function () {
          triggerGamePrewarm(gameId, pageUrl, archiveUrl);
        },
        { passive: true },
      );

      // Captain's Log: record launch on click (before navigation)
      if (captainsLogId) {
        link.addEventListener("click", function () {
          if (window.__paCaptainsLog && window.__paCaptainsLog.addEntry) {
            window.__paCaptainsLog.addEntry(
              captainsLogId,
              link.textContent?.trim() || gameId,
              pageUrl,
            );
            window.__paCaptainsLog.incrementLaunchCount(captainsLogId);
          }
        });
      }
    });
  }
</script>

<style>
  .play-now__ctas {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }

  .before-launch {
    max-width: 580px;
    margin-left: auto;
    margin-right: auto;
  }

  .before-launch__inner {
    padding: 1.25rem 1.5rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    border-left: 3px solid var(--accent);
  }

  .before-launch__heading {
    font-family: var(--mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--accent);
    margin-bottom: 0.75rem;
  }

  .before-launch__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .before-launch__list li {
    font-size: 0.8125rem;
    color: var(--muted);
    line-height: 1.5;
    padding-left: 1rem;
    position: relative;
  }

  .before-launch__list li::before {
    content: "\25B8";
    position: absolute;
    left: 0;
    color: var(--accent);
  }

  .before-launch__list li strong {
    color: var(--ink);
  }

  .before-launch__footnote {
    margin-top: 0.75rem;
    font-size: 0.75rem;
    color: var(--muted);
    text-align: center;
  }

  .before-launch__footnote a {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .release-details__note a,
  .section__description a {
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .play-status {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    margin-top: -0.25rem;
    margin-bottom: 1.25rem;
    font-family: var(--mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
  }

  .play-status__item {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
  }

  .play-status__item--muted {
    opacity: 0.6;
  }

  .play-status__count {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.25rem;
    height: 1.25rem;
    border-radius: 50%;
    background: var(--accent);
    color: var(--ink);
    font-size: 0.625rem;
    font-weight: 600;
    line-height: 1;
  }

  .play-status__repeat {
    width: 100%;
    text-align: center;
    color: var(--muted);
    font-size: 0.625rem;
    text-transform: none;
    letter-spacing: normal;
    opacity: 0.7;
  }

  @media (min-width: 640px) {
    .play-now__ctas {
      flex-direction: row;
      justify-content: center;
      gap: 1rem;
    }
  }
</style>

<script is:inline src="/scripts/captains-log.js"></script>
