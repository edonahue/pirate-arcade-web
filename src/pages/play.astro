---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import GameCard from "../components/GameCard.astro";
import ArcadeFrame from "../components/ArcadeFrame.astro";
import { games } from "../data/games";
---

<BaseLayout
  title="Play"
  description="Choose your game from the Pirate Arcade collection. Desktop apps are available now; browser versions are planned."
  current="play"
>
  <Hero
    title="THE ARCADE"
    subtitle="Four pirate-themed arcade games, ready to download and play on
    your platform. Browser versions are planned."
    eyebrow="Pick your game"
  />

  <section class="section">
    <ArcadeFrame label="Game selection" topLabel="GAME SELECT  -  P1 READY">
      <div class="game-grid" style="padding: 1.5rem;">
        {games.map((game) => <GameCard game={game} />)}
      </div>
    </ArcadeFrame>
  </section>

  <section class="section">
    <div class="section__header">
      <p class="section__eyebrow">How to play</p>
      <h2 class="section__title">Desktop Apps</h2>
      <p class="section__description">
        Download the latest release from GitHub. Windows users can run the
        standalone executable directly. Linux users can install the Debian
        package. macOS users can build from source with PyInstaller.
      </p>
    </div>
    <div class="text-center mt-2">
      <a
        href="https://github.com/edonahue/pirate-arcade/releases"
        target="_blank"
        rel="noopener noreferrer"
        class="cta cta--primary"
      >
        Download Latest Release
      </a>
    </div>
  </section>

  <section class="section">
    <div class="section__header">
      <p class="section__eyebrow">Roadmap</p>
      <h2 class="section__title">Browser Versions</h2>
      <p class="section__description">
        Each game will eventually be playable directly in the browser. The
        porting work hasn't started yet — stay tuned for updates in the build
        log.
      </p>
    </div>
  </section>
</BaseLayout>
