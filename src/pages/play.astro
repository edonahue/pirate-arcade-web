---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import GameCard from "../components/GameCard.astro";
import ArcadeFrame from "../components/ArcadeFrame.astro";
import { games } from "../data/games";
import { webPageNode } from "../lib/schema";
---

<BaseLayout
  title="Play"
  description="Choose your game from the Pirate Arcade collection. Desktop apps available now; two browser ports are live."
  current="play"
  jsonLd={[
    webPageNode(
      "/play/",
      "Play Pirate Arcade",
      "Choose your game from the Pirate Arcade collection. Desktop apps available now; two browser ports are live.",
      "CollectionPage",
    ),
  ]}
>
  <Hero
    title="THE ARCADE"
    subtitle="Pirate-themed arcade games. Cannonball Clash and Treasure Cove
    are playable in your browser now. Desktop downloads available for all four games."
    eyebrow="Pick your game"
  />

  <section class="section">
    <ArcadeFrame label="Game selection" topLabel="GAME SELECT  -  P1 READY">
      <div style="padding: 1.5rem;">
        <h2 class="sr-only">Available Games</h2>
        <div class="game-grid">
          {games.map((game) => <GameCard game={game} />)}
        </div>
      </div>
    </ArcadeFrame>
  </section>

  <section class="section">
    <div class="section__header">
      <p class="section__eyebrow">How to play</p>
      <h2 class="section__title">Desktop Apps</h2>
      <p class="section__description">
        Two games are now <strong>playable in the browser</strong> via Pygbag/WebAssembly:
        Cannonball Clash and Treasure Cove. The remaining two games are still desktop-only
        for now — download the latest release below.
      </p>
    </div>

    <div class="text-center mt-2">
      <a
        href="https://github.com/edonahue/pirate-arcade/releases"
        target="_blank"
        rel="noopener noreferrer"
        class="cta cta--primary"
      >
        Download Latest Release
      </a>
    </div>

    <div class="release-details mt-2">
      <div class="release-details__grid">
        <div class="release-details__item">
          <span class="release-details__label">Latest version</span>
          <span class="release-details__value">v2.0.0</span>
        </div>
        <div class="release-details__item">
          <span class="release-details__label">Windows</span>
          <span class="release-details__value">Standalone .exe</span>
        </div>
        <div class="release-details__item">
          <span class="release-details__label">Linux</span>
          <span class="release-details__value">.deb package</span>
        </div>
        <div class="release-details__item">
          <span class="release-details__label">macOS</span>
          <span class="release-details__value">Build from source</span>
        </div>
      </div>
      <p class="release-details__note">
        <a href="/build-log/launching-on-free-infrastructure">
          Read about the infrastructure
        </a>
        {" \u2014 "}how everything ships on free tiers.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="section__header">
      <p class="section__eyebrow">Feasibility</p>
      <h2 class="section__title">Browser Ports</h2>
      <p class="section__description">
        Two games are now playable in the browser via Pygbag/WebAssembly:
        <strong>Cannonball Clash</strong> and <strong>Treasure Cove</strong>.
        The CPython runtime (~12 MB) loads on first visit; each game code bundle
        is under 20 KB. Game audio is synthesized in-browser via Web Audio API.
        Audio starts after your first click (browser autoplay rules).
        <br /><br />
        See the <a href="/build-log/shipping-first-browser-port"
          >first shipping post</a
        > and the <a href="/build-log/porting-the-second-game-treasure-cove"
          >second port post</a
        > for the full story on what it takes to get Python+Pygame games running in
        the browser.
      </p>
      <div class="text-center mt-2">
        <a
          href="/play/cannonball-clash/"
          target="_blank"
          rel="noopener noreferrer"
          class="cta cta--primary"
        >
          Play Cannonball Clash
        </a>
      </div>
      <div class="text-center mt-2">
        <a
          href="/play/treasure-cove/"
          target="_blank"
          rel="noopener noreferrer"
          class="cta cta--primary"
        >
          Play Treasure Cove
        </a>
      </div>
      <p
        class="section__description mt-1"
        style="font-size:0.85em;color:#6b7a8f;"
      >
        Works best with a keyboard. On-screen touch controls available on
        mobile.
      </p>
      <p class="section__description mt-2">
        <a href="/build-log/browser-port-feasibility">
          Read the feasibility analysis
        </a>
        {" \u2014 "}Pygbag vs Canvas rewrite trade-offs.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="section__header">
      <p class="section__eyebrow">Roadmap</p>
      <h2 class="section__title">Remaining Ports</h2>
      <p class="section__description">
        With Cannonball Clash and Treasure Cove shipped, the same approach will
        be used to port Kraken's Wake and Port Royale Tycoon to the browser.
        Each game requires individual audio and renderer fixes.
      </p>
    </div>
  </section>
</BaseLayout>
