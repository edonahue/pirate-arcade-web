---
import BaseLayout from "../layouts/BaseLayout.astro";
import CTAButton from "../components/CTAButton.astro";
import { site } from "../data/profile";
import { games } from "../data/games";
import { webPageNode } from "../lib/schema";

const browserGames = games.filter((g) => g.status === "browser-playable");
---

<BaseLayout
  title="About"
  description={`About Pirate Arcade: a pirate-themed arcade collection and public build experiment by Erich Donahue. ${browserGames.length} browser games across two engines on free infrastructure.`}
  current="about"
  jsonLd={[
    webPageNode(
      "/about/",
      "About Pirate Arcade",
      `About Pirate Arcade: a pirate-themed arcade collection and public build experiment by Erich Donahue. ${browserGames.length} browser games across two engines on free infrastructure.`,
      "AboutPage",
    ),
  ]}
>
  <section class="section">
    <div class="section__header">
      <p class="section__eyebrow">About</p>
      <h1 class="section__title">The Project</h1>
    </div>

    <div class="prose">
      <p>
        Pirate Arcade is a collection of {games.length} classic arcade games reimagined
        with a pirate nautical theme. It's also a public workbench — an experiment
        in how far a zero-cost AI-assisted development workflow can go when you combine
        free coding tools, local hardware, and open source infrastructure.
      </p>
    </div>
    <p class="text-center mt-1">
      <CTAButton href="/play" variant="primary">Play in Browser</CTAButton>
      <CTAButton href="/source" variant="outline"> How It's Built </CTAButton>
    </p>
  </section>

  <section class="section">
    <div class="section__header">
      <p class="section__eyebrow">Builder</p>
      <h2 class="section__title">Product-Minded Engineering</h2>
      <p class="section__description">
        This project demonstrates decision-making across the product stack:
        choosing the right abstraction (Phaser vs Pygbag) and designing for
        constraints (free infrastructure, mobile touch). The engineering
        evidence lives on the <a href="/source/">Source</a> page.
      </p>
    </div>
    <div class="prose">
      <p>
        The work reflects a background in decision science, data products, and
        practical systems — building tools that solve real problems, documenting
        what works, and treating AI as a force multiplier rather than a
        replacement for judgment.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="section__header">
      <p class="section__eyebrow">Why</p>
      <h2 class="section__title">Why Pirate Arcade?</h2>
    </div>
    <div class="prose">
      <p>
        Classic arcade games are well-understood problems, making them ideal
        test cases for evaluating AI-assisted coding tools. Every game here is a
        data point in the experiment — a record of what worked, what didn't, and
        how the development process changes when code generation is essentially
        free.
      </p>
      <p>
        This is not a commercial game studio. Not a startup. Not a subscription
        product. It's a public side project — a workspace for exploring
        zero-cost AI workflows and shipping real software on free
        infrastructure.
      </p>
    </div>
  </section>

  <section class="section section--pyle">
    <div class="section__header">
      <p class="section__eyebrow">Maker</p>
      <h2 class="section__title">Made by {site.author}</h2>
    </div>

    <div class="maker-card">
      <div class="maker-card__body">
        <p class="maker-card__desc">
          {site.authorDescription} I build practical decision tools, data products,
          and creative systems. This project is my public workbench for exploring
          AI-assisted development — the boundary of what a single person with good
          tools and free infrastructure can ship.
        </p>
        <div class="maker-card__links">
          <a
            href={site.personalSiteUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="maker-card__link"
          >
            erichdonahue.com
          </a>
          <a
            href={site.githubUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="maker-card__link"
          >
            github/edonahue
          </a>
          <a
            href={site.linkedInUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="maker-card__link"
          >
            LinkedIn
          </a>
          <a
            href={site.buyMeACoffeeUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="maker-card__link maker-card__link--muted"
          >
            Buy me a coffee
          </a>
        </div>
      </div>
    </div>

    <img
      class="section__art"
      src="/images/art/pyle-treasure-division.webp"
      alt=""
      aria-hidden="true"
      decoding="async"
      loading="lazy"
    />
  </section>
</BaseLayout>

<style>
  .maker-card {
    max-width: 36rem;
    margin-top: 1.5rem;
    background: var(--surface-card);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: 1.5rem 2rem;
    box-shadow: var(--shadow-soft), var(--glow-brass);
  }

  .maker-card__desc {
    font-size: 0.9375rem;
    color: var(--muted);
    line-height: 1.7;
    margin-bottom: 1.25rem;
  }

  .maker-card__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .maker-card__link {
    font-family: var(--mono);
    font-size: 0.8125rem;
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .maker-card__link:hover {
    color: var(--ink);
  }

  .maker-card__link--muted {
    color: var(--muted);
  }

  @media (max-width: 640px) {
    .maker-card {
      padding: 1.25rem 1.25rem;
    }

    .maker-card__desc {
      font-size: 0.875rem;
      margin-bottom: 1rem;
    }

    .maker-card__links {
      gap: 0.5rem;
    }

    .maker-card__link {
      font-size: 0.75rem;
    }
  }

  @media (max-width: 380px) {
    .maker-card {
      padding: 1rem;
    }

    .maker-card__link {
      font-size: 0.6875rem;
    }
  }
</style>
