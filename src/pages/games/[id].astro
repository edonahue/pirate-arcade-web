---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CTAButton from "../../components/CTAButton.astro";
import { games } from "../../data/games";
import { breadcrumbNode, gameNode, webPageNode } from "../../lib/schema";
import {
  isPygbag,
  isWebNative,
  getBrowserLoadLabel,
  getBrowserEngineLabel,
  getChallengeLabel,
  getDesktopReleaseUrl,
  getArchiveUrl,
  getLaunchLinkAttrs,
} from "../../lib/gameLaunch";

export function getStaticPaths() {
  return games.map((game) => ({
    params: { id: game.id },
    props: { game },
  }));
}

const { game } = Astro.props;
const gameUrl = `/games/${game.id}/`;
const title = `${game.title} — Pirate Arcade`;
const description =
  game.seoDescription ??
  `${game.title} is a pirate-themed ${game.classic} arcade game in Pirate Arcade. ${game.description}`;
const engineLabel = getBrowserEngineLabel(game);
const loadLabel = getBrowserLoadLabel(game);
const challengeLabel = getChallengeLabel(game);

const browserGames = games.filter((g) => g.status === "browser-playable");

const challengeLabels: Record<string, string> = {
  easier: "Easier",
  balanced: "Balanced",
  harder: "Harder",
};

// Next game offers a different gameplay challenge (registry order
// tie-break). Desktop-only falls back to the first browser-playable game.
const getNextGame = (current: typeof game): typeof game | undefined => {
  if (current.status !== "browser-playable") return browserGames[0];
  return (
    browserGames.find(
      (g) => g.id !== current.id && g.challenge !== current.challenge,
    ) ?? browserGames.find((g) => g.id !== current.id)
  );
};

const nextGame = getNextGame(game);

const getNextTag = (g: typeof game): string => {
  if (g.challenge && g.challenge !== game.challenge)
    return `Different challenge: ${challengeLabels[g.challenge] ?? g.challenge}`;
  return "";
};
---

<BaseLayout
  title={title}
  titleTemplate="literal"
  description={description}
  current="play"
  ogImage={game.screenshot ?? "/og-image.png"}
  jsonLd={[
    webPageNode(gameUrl, title, description, "WebPage"),
    gameNode(game),
    breadcrumbNode([
      { name: "Home", url: "/" },
      { name: "Play", url: "/play/" },
      { name: game.title, url: gameUrl },
    ]),
  ]}
>
  <article class="section">
    <div class="section__header">
      <p class="section__eyebrow">{game.classic}</p>
      <h1 class="section__title">{game.title}</h1>
      <p class="section__description">{game.description}</p>
    </div>

    <div class="game-detail__chips">
      {
        game.status === "browser-playable" && (
          <>
            <span class="chip chip--phaser">Instant start</span>
            {game.status === "browser-playable" && !isWebNative(game) && (
              <span class="chip chip--pygbag">Runtime load</span>
            )}
          </>
        )
      }
      {
        game.status === "browser-playable" && (
          <span class="chip chip--browser">Playable in browser</span>
        )
      }
      {
        game.status === "desktop-available" && (
          <span class="chip chip--desktop">Desktop download</span>
        )
      }
    </div>

    {
      game.firstPlayTip && (
        <div class="game-detail__quick-start">
          <span class="game-detail__quick-start-label">Quick start</span>
          <p class="game-detail__quick-start-text">{game.firstPlayTip}</p>
          {(game.challenge || game.touchDifficultyLabel) && (
            <p class="game-detail__quick-start-facts">
              {game.challenge && (
                <span>
                  Challenge: {challengeLabels[game.challenge] ?? game.challenge}
                </span>
              )}
              {game.challenge && game.touchDifficultyLabel && (
                <span aria-hidden="true"> · </span>
              )}
              {game.touchDifficultyLabel && (
                <span>Touch: {game.touchDifficultyLabel}</span>
              )}
            </p>
          )}
        </div>
      )
    }

    {
      game.status === "browser-playable" && game.browserUrl ? (
        <div class="game-detail__hero-cta">
          <CTAButton href={game.browserUrl} variant="primary">
            ▶ Play in Browser
          </CTAButton>
        </div>
      ) : (
        <div class="game-detail__hero-cta">
          <CTAButton
            href={getDesktopReleaseUrl(game)}
            variant="primary"
            target="_blank"
            rel="noopener noreferrer"
          >
            ⬇ Download Desktop Release
          </CTAButton>
        </div>
      )
    }

    {
      game.screenshot && (
        <figure class="game-detail__figure">
          {game.status === "browser-playable" && game.browserUrl ? (
            <a
              class="game-detail__screenshot-link"
              aria-label={`${game.title} screenshot — play in browser`}
              {...getLaunchLinkAttrs(game)!}
            >
              <img
                src={game.screenshot}
                alt={`${game.title} gameplay screenshot`}
                width="1280"
                height="720"
                loading="eager"
              />
            </a>
          ) : (
            <img
              src={game.screenshot}
              alt={`${game.title} gameplay screenshot`}
              width="1280"
              height="720"
              loading="eager"
            />
          )}
        </figure>
      )
    }

    <div class="prose">
      <h2>How to play</h2>
      <p>{game.howToPlay}</p>

      {
        game.touchControls && (
          <>
            <h2>Touch controls</h2>
            <p class="controls-summary">{game.touchControls}</p>
          </>
        )
      }

      {
        game.keyboardControls && (
          <>
            <h2>Keyboard controls</h2>
            <p class="controls-summary">{game.keyboardControls}</p>
          </>
        )
      }

      <h2>Tips</h2>
      <p>{game.tips}</p>

      {
        game.features && game.features.length > 0 && (
          <>
            <h2>Features</h2>
            <ul>
              {game.features.map((feature) => (
                <li>{feature}</li>
              ))}
            </ul>
          </>
        )
      }

      {
        game.demonstrates && game.demonstrates.length > 0 && (
          <>
            <h2>Behind the build</h2>
            <p>
              {game.title} is{" "}
              {isWebNative(game)
                ? "built as a web-native Phaser game that runs directly in your browser."
                : isPygbag(game)
                  ? "a Pygbag/WebAssembly port of the original Python game."
                  : "part of the Python and Pygame desktop collection."}
            </p>
            <ul class="game-detail__demonstrates">
              {game.demonstrates.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </>
        )
      }

      <h2>Availability</h2>
      <p>{game.availabilityNote}</p>
    </div>

    {
      game.id === "race-to-treasure-island" && (
        <div class="prose">
          <h2>Treasure Island & Long John Silver</h2>
          <p>
            Race to Treasure Island draws inspiration from Robert Louis
            Stevenson's classic novel <em>Treasure Island</em> (1883). The rival
            pirate Long John Silver — "Long John" in-game — is the novel's
            iconic one-legged sea-cook turned mutineer.
          </p>
          <p>
            Louis Rhead (1857–1926) illustrated a 1915 edition of{" "}
            <em>Treasure Island</em> with dramatic full-page artwork. His
            illustrations capture the novel's stormy, dangerous atmosphere.
          </p>
          <figure class="game-detail__art-figure">
            <img
              src="/images/art/rhead-treasure-island-cover.webp"
              alt="Treasure Island cover illustration by Louis Rhead"
              width="1000"
              height="1491"
              loading="lazy"
              class="game-detail__art"
            />
            <figcaption>
              Treasure Island cover illustration by Louis Rhead (1915).{" "}
              <a
                href="https://www.gutenberg.org/ebooks/120"
                target="_blank"
                rel="noopener noreferrer"
              >
                Project Gutenberg
              </a>
              , public domain.
            </figcaption>
          </figure>
        </div>
      )
    }

    <div class="game-detail__keep-playing">
      <h2 class="game-detail__keep-playing-title">Keep playing</h2>
      <div class="game-detail__keep-playing-grid">
        <div class="game-detail__keep-playing-card">
          <span class="game-detail__keep-playing-heading">Play this game</span>
          {
            game.status === "browser-playable" && game.browserUrl && (
              <a
                class="game-detail__keep-playing-link game-detail__keep-playing-link--primary"
                {...getLaunchLinkAttrs(game)!}
              >
                ▶ Play in Browser
              </a>
            )
          }
          {
            game.desktopUrl && (
              <a
                href={getDesktopReleaseUrl(game)}
                class="game-detail__keep-playing-link"
                target="_blank"
                rel="noopener noreferrer"
              >
                Desktop download →
              </a>
            )
          }
        </div>
        <div class="game-detail__keep-playing-card">
          <span class="game-detail__keep-playing-heading">Back to arcade</span>
          <a href="/play/" class="game-detail__keep-playing-link">
            See all games →
          </a>
        </div>
        {
          nextGame && (
            <div class="game-detail__keep-playing-card">
              <span class="game-detail__keep-playing-heading">Try next</span>
              <span class="game-detail__keep-playing-tag">
                {getNextTag(nextGame)}
              </span>
              {nextGame.status === "browser-playable" && nextGame.browserUrl ? (
                <a
                  class="game-detail__keep-playing-link"
                  {...getLaunchLinkAttrs(nextGame)!}
                >
                  {nextGame.title}
                </a>
              ) : (
                <a
                  href={`/games/${nextGame.id}/`}
                  class="game-detail__keep-playing-link"
                >
                  {nextGame.title}
                </a>
              )}
              {nextGame.bestFor && (
                <p class="game-detail__keep-playing-desc">{nextGame.bestFor}</p>
              )}
            </div>
          )
        }
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .game-detail__chips {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-bottom: 1.5rem;
  }
  .game-detail__hero-cta {
    margin-bottom: 1.5rem;
  }
  .game-detail__screenshot-link {
    display: block;
    transition: opacity 0.2s;
    position: relative;
  }
  .game-detail__screenshot-link:hover {
    opacity: 0.85;
  }
  .game-detail__screenshot-link img {
    cursor: pointer;
  }
  .game-detail__screenshot-link:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
    border-radius: var(--radius-lg);
  }
  .chip {
    font-family: var(--mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 0.25rem 0.75rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--line);
    color: var(--muted);
    background: var(--surface);
  }
  .chip--phaser {
    color: var(--accent);
    border-color: var(--accent);
    background: rgba(42, 166, 161, 0.08);
  }
  .chip--pygbag {
    color: var(--brass);
    border-color: var(--brass);
    background: rgba(201, 164, 92, 0.08);
  }
  .chip--browser {
    color: var(--ink);
    border-color: var(--ink);
  }
  .chip--desktop {
    opacity: 0.6;
  }
  .game-detail__figure {
    margin-bottom: 2rem;
  }
  .game-detail__figure img {
    width: 100%;
    height: auto;
    border-radius: var(--radius-lg);
    border: 1px solid var(--line);
  }
  .game-detail__art-figure {
    margin: 1.5rem 0;
    text-align: center;
  }
  .game-detail__art {
    max-width: 100%;
    height: auto;
    border-radius: var(--radius-sm);
    border: 1px solid var(--line);
  }
  .game-detail__art-figure figcaption {
    font-family: var(--mono);
    font-size: 0.6875rem;
    color: var(--muted);
    margin-top: 0.5rem;
  }
  .game-detail__art-figure figcaption a {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .game-detail__quick-start {
    padding: 0.75rem 1rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    border-left: 3px solid var(--accent);
    margin-bottom: 1.5rem;
  }
  .game-detail__quick-start-label {
    font-family: var(--mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent);
  }
  .game-detail__quick-start-text {
    font-size: 0.9375rem;
    color: var(--ink);
    margin-top: 0.25rem;
    line-height: 1.6;
  }
  .game-detail__quick-start-facts {
    font-family: var(--mono);
    font-size: 0.75rem;
    color: var(--muted);
    margin-top: 0.5rem;
    line-height: 1.6;
  }
  .game-detail__demonstrates {
    list-style: none;
    padding: 0;
    margin: 0 0 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .game-detail__demonstrates li {
    font-size: 0.875rem;
    color: var(--muted);
    line-height: 1.6;
    padding-left: 1.25rem;
    position: relative;
  }
  .game-detail__demonstrates li::before {
    content: "\25B8";
    position: absolute;
    left: 0;
    color: var(--accent);
  }

  @media (max-width: 640px) {
    .game-detail__figure {
      margin-bottom: 1.5rem;
    }

    .game-detail__figure img {
      border-radius: var(--radius);
    }

    .game-detail__quick-start {
      padding: 0.625rem 0.875rem;
      margin-bottom: 1rem;
    }

    .game-detail__quick-start-text {
      font-size: 0.875rem;
    }

    .game-detail__demonstrates li {
      font-size: 0.8125rem;
      padding-left: 1rem;
    }

    .game-detail__art-figure {
      margin: 1rem 0;
    }

    .game-detail__art-figure figcaption {
      font-size: 0.625rem;
    }

    .game-detail__keep-playing-grid {
      grid-template-columns: 1fr;
    }
  }

  .game-detail__keep-playing {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--line);
  }

  .game-detail__keep-playing-title {
    font-family: var(--display);
    font-size: 1.25rem;
    color: var(--ink);
    margin-bottom: 1.25rem;
  }

  .game-detail__keep-playing-grid {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 1rem;
  }

  .game-detail__keep-playing-card {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .game-detail__keep-playing-heading {
    font-family: var(--mono);
    font-size: 0.625rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--accent);
  }

  .game-detail__keep-playing-link {
    font-size: 0.875rem;
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 2px;
    line-height: 1.4;
  }

  .game-detail__keep-playing-link:hover {
    color: var(--ink);
  }

  .game-detail__keep-playing-link--primary {
    display: inline-block;
    font-family: var(--mono);
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--paper-cta-fg);
    background: var(--paper-cta-bg);
    border: 1px solid var(--paper-cta-border);
    border-radius: var(--radius);
    padding: 0.5rem 1rem;
    text-decoration: none;
    text-align: center;
  }

  .game-detail__keep-playing-link--primary:hover {
    background: var(--paper-cta-border);
  }

  .game-detail__keep-playing-tag {
    font-family: var(--mono);
    font-size: 0.625rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 0.125rem 0.375rem;
    border: 1px solid var(--sea);
    color: var(--sea);
    border-radius: 3px;
    align-self: flex-start;
  }

  .game-detail__keep-playing-desc {
    font-size: 0.8125rem;
    color: var(--muted);
    line-height: 1.4;
  }
</style>
