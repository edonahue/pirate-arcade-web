---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CTAButton from "../../components/CTAButton.astro";
import { games } from "../../data/games";
import { breadcrumbNode, gameNode, webPageNode } from "../../lib/schema";

export function getStaticPaths() {
  return games.map((game) => ({
    params: { id: game.id },
    props: { game },
  }));
}

const { game } = Astro.props;
const gameUrl = `/games/${game.id}/`;
const title = `${game.title} — Pirate Arcade`;
const description = `${game.title} is a pirate-themed ${game.classic} arcade game in Pirate Arcade. ${game.description}`;

const touchControls: Record<string, string> = {
  "cannonball-clash":
    "Slide your ship up/down on the left side • START • PAUSE",
  "treasure-cove":
    "Slide the longboat left/right on the bottom • LAUNCH • PAUSE",
  "krakens-wake":
    "TURN ◀/▶ • THRUST (green button) • FIRE (red button) • PAUSE",
};

const keyboardControls: Record<string, string> = {
  "cannonball-clash":
    "ArrowUp / W — move up • ArrowDown / S — move down • Space / Escape — pause • Enter — confirm",
  "treasure-cove":
    "ArrowLeft / A — move left • ArrowRight / D — move right • Space — launch ball • Escape — pause • Enter — confirm",
  "krakens-wake":
    "ArrowLeft / A — turn left • ArrowRight / D — turn right • ArrowUp / W — thrust • Space — fire • Escape / P — pause • Enter — confirm",
};

const howToPlay: Record<string, string> = {
  "cannonball-clash":
    "Defend your fortress and sink your opponent's ship with well-aimed cannon shots. First to 11 hits wins. Use the slide zone or nudge buttons to move your ship up and down. Tap START to begin each round.",
  "treasure-cove":
    "Smash through the fortress walls to reach the treasure hoard. Slide the longboat left and right to bounce the ball. Tap LAUNCH to serve. Each brick row has different durability — watch for cracks!",
  "krakens-wake":
    "Navigate treacherous waters and blast sea monsters. Turn your ship, thrust forward, and fire cannons to survive waves. Collect treasure pickups for bonus points. Watch for the Kraken — it hits hard!",
};

const tips: Record<string, string> = {
  "cannonball-clash":
    "The AI ramps up in difficulty. Power-ups (gold glow) make your paddle bigger temporarily. Audio unlocks after your first tap.",
  "treasure-cove":
    "Bricks show row-specific stone colors. The last-hit brick pulses gold. The ball speeds up over time. Lives: 3.",
  "krakens-wake":
    "THRUST applies forward momentum; let go to coast. FIRE has a cooldown. Treasure pickups give bonus points. 3 lives per game.",
};
---

<BaseLayout
  title={title}
  titleTemplate="literal"
  description={description}
  current="play"
  ogImage={game.screenshot ?? "/og-image.png"}
  jsonLd={[
    webPageNode(gameUrl, title, description, "WebPage"),
    gameNode(game),
    breadcrumbNode([
      { name: "Home", url: "/" },
      { name: "Play", url: "/play/" },
      { name: game.title, url: gameUrl },
    ]),
  ]}
>
  <article class="section">
    <div class="section__header">
      <p class="section__eyebrow">{game.classic}</p>
      <h1 class="section__title">{game.title}</h1>
      <p class="section__description">{game.description}</p>
    </div>

    {
      game.screenshot && (
        <figure class="game-detail__figure">
          <img
            src={game.screenshot}
            alt={`${game.title} gameplay screenshot`}
            width="1280"
            height="720"
            loading="eager"
          />
        </figure>
      )
    }

    <div class="prose">
      <h2>What it is</h2>
      <p>
        {game.title} is Pirate Arcade's nautical take on {game.classic}. It is
        part of a four-game Python and Pygame arcade collection built as a
        zero-cost AI-assisted development experiment.
      </p>

      <h2>How to play</h2>
      <p>{howToPlay[game.id]}</p>

      <h2>Touch controls</h2>
      <p class="controls-summary">{touchControls[game.id]}</p>

      <h2>Keyboard controls</h2>
      <p class="controls-summary">{keyboardControls[game.id]}</p>

      <h2>Tips</h2>
      <p>{tips[game.id]}</p>

      <h2>Availability</h2>
      <p>
        {
          game.browserUrl
            ? "This game is playable in the browser now via Pygbag and WebAssembly, and it is also included in the desktop release."
            : "This game is available in the desktop release now. The Pygbag/WebAssembly pipeline proved effective for arcade games, but a turn-based board game with point-and-click controls needs a different approach. A browser version is under evaluation (see the build log for details)."
        }
      </p>

      {
        game.features && game.features.length > 0 && (
          <>
            <h2>Features</h2>
            <ul>
              {game.features.map((feature) => (
                <li>{feature}</li>
              ))}
            </ul>
          </>
        )
      }
    </div>

    <div class="text-center mt-2">
      {
        game.browserUrl && (
          <CTAButton href={game.browserUrl} variant="primary">
            Play in Browser
          </CTAButton>
        )
      }
      {
        game.desktopUrl && (
          <CTAButton href={game.desktopUrl} variant="gold">
            Download Desktop Release
          </CTAButton>
        )
      }
      <CTAButton href="/play" variant="outline">All Games</CTAButton>
    </div>
  </article>
</BaseLayout>
