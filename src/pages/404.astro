---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Lost at Sea" description="Page not found — Pirate Arcade">
  <section class="section">
    <div class="section__header">
      <p class="section__eyebrow">Error 404</p>
      <h1 class="section__title" style="font-size: clamp(4rem, 12vw, 8rem);">
        LOST AT SEA
      </h1>
      <p class="section__description">
        This page drifted off the map. No treasure here — just open water.
      </p>
    </div>

    <div class="lost-at-sea__actions text-center mt-4">
      <a href="/" class="cta cta--primary"> Back to Shore </a>
      <a href="/play/" class="cta cta--gold"> Enter the Arcade </a>
      <a href="/build-log/" class="cta cta--outline"> Read the Build Log </a>
    </div>
  </section>
</BaseLayout>

<style>
  .lost-at-sea__actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }
</style>
