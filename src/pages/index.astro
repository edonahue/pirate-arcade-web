---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import CTAButton from "../components/CTAButton.astro";
import GameCard from "../components/GameCard.astro";
import { games } from "../data/games";
import { webPageNode } from "../lib/schema";
---

<BaseLayout
  current="home"
  jsonLd={[
    webPageNode(
      "/",
      "Pirate Arcade",
      "Four classic arcade games reimagined with a nautical twist. Built in the open as an experiment in zero-cost AI-assisted development.",
      "CollectionPage",
    ),
  ]}
>
  <Hero
    title="PIRATE ARCADE"
    subtitle="Four classic arcade games reimagined with a nautical twist. Built in the open as an experiment in zero-cost AI-assisted development."
    eyebrow="Ahoy, captain!"
    backgroundImage="/images/art/pyle-marooned.webp"
  >
    <CTAButton href="/play" variant="primary">Get the Arcade</CTAButton>
    <CTAButton href="/build-log" variant="gold">Read the Build Log</CTAButton>
    <CTAButton href="/source" variant="outline">View Source</CTAButton>
  </Hero>

  <section class="section">
    <div class="section__header">
      <p class="section__eyebrow">The Games</p>
      <h2 class="section__title">Choose Your Adventure</h2>
      <p class="section__description">
        Four classic arcade games, each reimagined with pirate flavor and modern
        visual effects.
      </p>
    </div>
    <div class="game-grid">
      {games.map((game) => <GameCard game={game} />)}
    </div>
  </section>

  <div class="section-divider" aria-hidden="true">
    <span class="section-divider__line"></span>
    <span class="section-divider__dot"></span>
    <span class="section-divider__line"></span>
  </div>

  <section class="section">
    <div class="section__header">
      <p class="section__eyebrow">Browser Play</p>
      <h2 class="section__title">Play in Browser Now</h2>
      <p class="section__description">
        Three games are playable immediately in your browser via
        Pygbag/WebAssembly: Cannonball Clash, Treasure Cove, and Kraken's Wake.
        Each loads a ~12 MB CPython runtime on first visit; audio starts after
        your first click. Works best with a keyboard, with on-screen touch
        controls available on mobile.
      </p>
    </div>

    <div class="recommended-first mt-4">
      <div class="recommended-first__card">
        <span class="recommended-first__badge">Recommended first</span>
        <h3 class="recommended-first__title">Cannonball Clash</h3>
        <p class="recommended-first__desc">
          Naval cannon duel — slide your ship up/down, tap START. Easiest on
          touch.
        </p>
        <a
          href="/play/cannonball-clash/"
          target="_blank"
          rel="noopener noreferrer"
          class="cta cta--primary"
        >
          Play Cannonball Clash
        </a>
      </div>
    </div>

    <div class="text-center mt-2">
      <div class="play-home__ctas">
        <a
          href="/play/treasure-cove/"
          target="_blank"
          rel="noopener noreferrer"
          class="cta cta--gold"
        >
          Play Treasure Cove
        </a>
        <a
          href="/play/krakens-wake/"
          target="_blank"
          rel="noopener noreferrer"
          class="cta cta--outline"
        >
          Play Kraken's Wake
        </a>
      </div>
    </div>
    <p class="section__description mt-4 text-center text-sm">
      <a href="/build-log/shipping-first-browser-port"
        >Read about the browser porting journey</a
      >
      {" • "}
      <a href="/build-log/porting-the-second-game-treasure-cove"
        >See the technical details</a
      >{" • "}
      <a href="/build-log/browser-port-feasibility">Porting roadmap</a>
    </p>
    <style>
      .play-home__ctas {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        justify-content: center;
        align-items: center;
      }
    </style>
  </section>

  <div class="section-divider" aria-hidden="true">
    <span class="section-divider__line"></span>
    <span class="section-divider__dot"></span>
    <span class="section-divider__line"></span>
  </div>

  <section class="section section--pyle">
    <div class="section__header">
      <p class="section__eyebrow">The Experiment</p>
      <h2 class="section__title">Free AI, Local Hardware, Open Source</h2>
      <p class="section__description">
        This project explores how far a zero-cost AI-assisted development
        workflow can go. For this project: OpenCode terminal coding agent,
        free-to-use models, a local X600 workstation, GitHub, and Cloudflare's
        free tier. No paid AI subscriptions, no cloud compute credits, no SaaS
        lock-in.
      </p>
    </div>
    <div class="text-center mt-2">
      <CTAButton href="/build-log" variant="gold">Read the Build Log</CTAButton>
    </div>
    <img
      class="section__art"
      src="/images/art/pyle-treasure-division.webp"
      alt=""
      aria-hidden="true"
      decoding="async"
      loading="lazy"
    />
  </section>
</BaseLayout>
