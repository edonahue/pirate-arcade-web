---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import CTAButton from "../components/CTAButton.astro";
import GameCard from "../components/GameCard.astro";
import { games } from "../data/games";
import { webPageNode } from "../lib/schema";

const browserGames = games.filter((g) => g.status === "browser-playable");
const pygbagGames = browserGames.filter((g) => g.engine === "pygbag");
const webNativeGames = browserGames.filter((g) => g.engine === "phaser");
---

<BaseLayout
  current="home"
  description={`A pirate-themed arcade collection and public build experiment. Play ${browserGames.length} browser games — ${webNativeGames.length} Phaser web-native ${webNativeGames.length === 1 ? "racer" : "racers"} and ${pygbagGames.length} Pygbag/WebAssembly ports, zero-cost AI-assisted.`}
  jsonLd={[
    webPageNode(
      "/",
      "Pirate Arcade",
      `A pirate-themed arcade collection and public build experiment. Play ${browserGames.length} browser games — ${webNativeGames.length} Phaser web-native ${webNativeGames.length === 1 ? "racer" : "racers"} and ${pygbagGames.length} Pygbag/WebAssembly ports, zero-cost AI-assisted.`,
      "CollectionPage",
    ),
  ]}
>
  <Hero
    title="PIRATE ARCADE"
    subtitle={`${games.length} classic arcade games reimagined with a nautical twist. Built in the open as an experiment in zero-cost AI-assisted development.`}
    eyebrow="Choose Your Course"
    backgroundImage="/images/art/pyle-marooned.webp"
    artPosition="50% 25%"
  >
    <CTAButton href="/play" variant="primary">Enter the Arcade</CTAButton>
    <CTAButton href="/build-log" variant="gold">Read the Build Log</CTAButton>
  </Hero>

  <p class="hero__credit">
    A playable arcade collection and public build experiment by
    <a href="https://erichdonahue.com" target="_blank" rel="noopener noreferrer"
      >Erich Donahue</a
    >.
  </p>

  <section class="section section--games">
    <div class="section__header">
      <p class="section__eyebrow">On the Chart</p>
      <h2 class="section__title">{games.length} Pirate Arcade Games</h2>
      <p class="section__description">
        {games.length} classic arcade games, each reimagined with pirate flavor and
        modern visual effects. {browserGames.length} browser-playable — {
          pygbagGames.length
        }
        Pygbag/WebAssembly ports and {webNativeGames.length} web-native Phaser
        {webNativeGames.length === 1 ? "racer" : "racers"}.
      </p>
    </div>

    <!-- Stats strip -->
    <div class="stats-strip">
      <div class="stats-strip__item">
        <span class="stats-strip__count">{games.length}</span>
        <span class="stats-strip__label">Total Games</span>
      </div>
      <div class="stats-strip__item">
        <span class="stats-strip__count">{browserGames.length}</span>
        <span class="stats-strip__label">Play in Browser</span>
      </div>
      <div class="stats-strip__item">
        <span class="stats-strip__count"
          >{games.length - browserGames.length}</span
        >
        <span class="stats-strip__label">Desktop Only</span>
      </div>
    </div>

    <div class="game-grid">
      {browserGames.map((game) => <GameCard game={game} />)}
    </div>

    <p class="desktop-callout">
      Plus <a href="/games/port-royale-tycoon/">Port Royale Tycoon</a>, a
      strategy game for desktop only.
    </p>

    <!-- Treasure Island cover vignette — edge fragment like old chart plate -->
    <img
      class="vignette--treasure-island"
      src="/images/art/rhead-treasure-island-cover.webp"
      alt=""
      aria-hidden="true"
      decoding="async"
      loading="lazy"
      width="400"
      height="600"
    />
  </section>

  <div class="section-divider" aria-hidden="true">
    <span class="section-divider__line"></span>
    <span class="section-divider__dot"></span>
    <span class="section-divider__line"></span>
  </div>

  <section class="section section--pyle">
    <div class="section__header">
      <p class="section__eyebrow">The Experiment</p>
      <h2 class="section__title">Free AI, Local Hardware, Open Source</h2>
      <p class="section__description">
        This project explores how far a zero-cost AI-assisted development
        workflow can go. For this project: OpenCode terminal coding agent,
        free-to-use models, a local X600 workstation, GitHub, and Cloudflare's
        free tier. No paid AI subscriptions, no cloud compute credits, no SaaS
        lock-in.
      </p>
    </div>

    <div class="proof-strip">
      <div class="proof-strip__item">
        <span class="proof-strip__label">Engines</span>
        <span class="proof-strip__value">Pygbag + Phaser</span>
      </div>
      <div class="proof-strip__item">
        <span class="proof-strip__label">Tests</span>
        <span class="proof-strip__value">Playwright suite</span>
      </div>
      <div class="proof-strip__item">
        <span class="proof-strip__label">Release gate</span>
        <span class="proof-strip__value">Multi-step automated</span>
      </div>
      <div class="proof-strip__item">
        <span class="proof-strip__label">Screenshots</span>
        <span class="proof-strip__value">Captured + validated</span>
      </div>
      <div class="proof-strip__item">
        <span class="proof-strip__label">Infrastructure</span>
        <span class="proof-strip__value">2 repos, free tier</span>
      </div>
    </div>

    <div class="text-center mt-2">
      <CTAButton href="/build-log" variant="gold">Read the Build Log</CTAButton>
    </div>
    <img
      class="section__art"
      src="/images/art/pyle-treasure-division.webp"
      alt=""
      aria-hidden="true"
      decoding="async"
      loading="lazy"
    />
  </section>
</BaseLayout>
