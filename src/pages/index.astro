---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import CTAButton from "../components/CTAButton.astro";
import GameCard from "../components/GameCard.astro";
import { games } from "../data/games";
import { webPageNode } from "../lib/schema";

const browserGames = games.filter((g) => g.status === "browser-playable");
const pygbagGames = browserGames.filter((g) => g.engine === "pygbag");
const webNativeGames = browserGames.filter((g) => g.engine === "phaser");
const desktopOnly = games.filter((g) => g.status === "desktop-available");
---

<BaseLayout
  current="home"
  jsonLd={[
    webPageNode(
      "/",
      "Pirate Arcade",
      "Five classic arcade games reimagined with a nautical twist. Built in the open as an experiment in zero-cost AI-assisted development.",
      "CollectionPage",
    ),
  ]}
>
  <Hero
    title="PIRATE ARCADE"
    subtitle="Five classic arcade games reimagined with a nautical twist. Built in the open as an experiment in zero-cost AI-assisted development."
    eyebrow="Play the Games"
    backgroundImage="/images/art/pyle-marooned.webp"
  >
    <CTAButton href="/play" variant="primary">Play the Games</CTAButton>
    <CTAButton href="/build-log" variant="gold">Read the Build Log</CTAButton>
    <CTAButton href="/source" variant="outline">View Source</CTAButton>
  </Hero>

  <section class="section">
    <div class="section__header">
      <p class="section__eyebrow">The Games</p>
      <h2 class="section__title">Five Pirate Arcade Games</h2>
      <p class="section__description">
        Five classic arcade games, each reimagined with pirate flavor and modern
        visual effects. {browserGames.length} browser-playable — three Pygbag/WebAssembly
        ports and one web-native Phaser racer.
      </p>
    </div>

    <!-- Stats strip -->
    <div class="stats-strip">
      <div class="stats-strip__item">
        <span class="stats-strip__count">{games.length}</span>
        <span class="stats-strip__label">Total Games</span>
      </div>
      <div class="stats-strip__item">
        <span class="stats-strip__count">{browserGames.length}</span>
        <span class="stats-strip__label">Browser-Ready</span>
      </div>
      <div class="stats-strip__item">
        <span class="stats-strip__count">{pygbagGames.length}</span>
        <span class="stats-strip__label">Pygbag Ports</span>
      </div>
      <div class="stats-strip__item">
        <span class="stats-strip__count">{webNativeGames.length}</span>
        <span class="stats-strip__label">Web-Native (Phaser)</span>
      </div>
      <div class="stats-strip__item">
        <span class="stats-strip__count">{desktopOnly.length}</span>
        <span class="stats-strip__label">Desktop-Only</span>
      </div>
    </div>

    <div class="game-grid">
      {games.map((game) => <GameCard game={game} />)}
    </div>
  </section>

  <div class="section-divider" aria-hidden="true">
    <span class="section-divider__line"></span>
    <span class="section-divider__dot"></span>
    <span class="section-divider__line"></span>
  </div>

  <section class="section">
    <div class="section__header">
      <p class="section__eyebrow">Featured</p>
      <h2 class="section__title">Race to Treasure Island</h2>
      <p class="section__description">
        Pirate Arcade's first web-native game. Top-down ship racing against Long
        John — load instantly, no runtime download. Built with Phaser 3.
      </p>
    </div>

    <div class="featured-game">
      <div class="featured-game__screenshot">
        <img
          src="/images/screenshot-race-to-treasure-island.png"
          alt="Race to Treasure Island gameplay screenshot"
          width="1280"
          height="720"
          loading="lazy"
        />
      </div>
      <div class="featured-game__info">
        <div class="featured-game__stat">
          <span class="featured-game__stat-label">Engine</span>
          <span class="featured-game__stat-value">Web-native Phaser 3</span>
        </div>
        <div class="featured-game__stat">
          <span class="featured-game__stat-label">Load</span>
          <span class="featured-game__stat-value">Instant — no download</span>
        </div>
        <div class="featured-game__stat">
          <span class="featured-game__stat-label">Course</span>
          <span class="featured-game__stat-value"
            >Seeded — same seed = same obstacles</span
          >
        </div>
        <div class="featured-game__stat">
          <span class="featured-game__stat-label">Rival</span>
          <span class="featured-game__stat-value">Long John Silver</span>
        </div>
        <a
          href="/play/race-to-treasure-island/"
          target="_blank"
          rel="noopener noreferrer"
          class="cta cta--primary featured-game__cta"
        >
          Play Race to Treasure Island
        </a>
      </div>
    </div>
  </section>

  <div class="section-divider" aria-hidden="true">
    <span class="section-divider__line"></span>
    <span class="section-divider__dot"></span>
    <span class="section-divider__line"></span>
  </div>

  <section class="section">
    <div class="section__header">
      <p class="section__eyebrow">All Browser Games</p>
      <h2 class="section__title">Play in Browser Now</h2>
      <p class="section__description">
        {browserGames.length} browser-playable games — {pygbagGames.length}
        Pygbag/WebAssembly ports and {webNativeGames.length} web-native Phaser racer.
        Pygbag games load a ~12 MB CPython runtime on first visit (cached on repeat);
        web-native games load instantly.
      </p>
    </div>

    <div class="recommended-first mt-4">
      <div class="recommended-first__card">
        <span class="recommended-first__badge">Recommended first</span>
        <h3 class="recommended-first__title">Cannonball Clash</h3>
        <p class="recommended-first__desc">
          Naval cannon duel — slide your ship up/down, tap START. Easiest on
          touch.
        </p>
        <a href="/play/cannonball-clash/" class="cta cta--primary">
          Play Cannonball Clash
        </a>
      </div>
      <div class="recommended-first__card">
        <span class="recommended-first__badge">Easiest on touch</span>
        <h3 class="recommended-first__title">Treasure Cove</h3>
        <p class="recommended-first__desc">
          Pirate Breakout — smash fortress walls. Medium on touch.
        </p>
        <a href="/play/treasure-cove/" class="cta cta--gold">
          Play Treasure Cove
        </a>
      </div>
      <div class="recommended-first__card">
        <span class="recommended-first__badge">Harder on touch</span>
        <h3 class="recommended-first__title">Kraken's Wake</h3>
        <p class="recommended-first__desc">
          Asteroids-style sea monster survival. Turn, thrust, fire.
        </p>
        <a href="/play/krakens-wake/" class="cta cta--outline">
          Play Kraken's Wake
        </a>
      </div>
    </div>
  </section>

  <div class="section-divider" aria-hidden="true">
    <span class="section-divider__line"></span>
    <span class="section-divider__dot"></span>
    <span class="section-divider__line"></span>
  </div>

  <section class="section section--pyle">
    <div class="section__header">
      <p class="section__eyebrow">The Experiment</p>
      <h2 class="section__title">Free AI, Local Hardware, Open Source</h2>
      <p class="section__description">
        This project explores how far a zero-cost AI-assisted development
        workflow can go. For this project: OpenCode terminal coding agent,
        free-to-use models, a local X600 workstation, GitHub, and Cloudflare's
        free tier. No paid AI subscriptions, no cloud compute credits, no SaaS
        lock-in.
      </p>
    </div>
    <div class="text-center mt-2">
      <CTAButton href="/build-log" variant="gold">Read the Build Log</CTAButton>
    </div>
    <img
      class="section__art"
      src="/images/art/pyle-treasure-division.webp"
      alt=""
      aria-hidden="true"
      decoding="async"
      loading="lazy"
    />
  </section>
</BaseLayout>
