---
import GamePlayLayout from "../../layouts/GamePlayLayout.astro";
import { games } from "../../data/games";

const game = games.find((g) => g.id === "race-to-treasure-island")!;
const title = `${game.title} — Pirate Arcade`;
---

<GamePlayLayout
  title={title}
  description={game.seoDescription!}
  ogImage={game.screenshot ?? "/og-image.png"}
>
  <!-- Rotate device overlay (portrait-only) -->
  <div id="rotate-overlay" class="rotate-overlay">
    <div class="rotate-overlay__inner">
      <div class="rotate-overlay__icon">↻</div>
      <p class="rotate-overlay__title">Turn your device sideways</p>
      <p class="rotate-overlay__text">
        Race to Treasure Island is best played in landscape orientation.
      </p>
      <a href="/play/" class="rotate-overlay__back">← Back to Arcade</a>
    </div>
  </div>

  <div id="game-shell" class="game-shell">
    <!-- Loading overlay -->
    <div id="game-loading" class="game-loading">
      <div class="loader-spinner"></div>
      <div class="loader-text">Loading Race to Treasure Island...</div>
      <div id="game-loading-detail" class="loader-detail">
        Booting Phaser engine...
      </div>
    </div>

    <!-- Game canvas -->
    <div id="game-container" class="game-container"></div>

    <!-- HUD overlay (top) -->
    <div id="hud-overlay" class="hud-overlay">
      <a id="back-link" href="/play/" class="hud-back">← Back</a>
      <button
        id="touch-help-button"
        class="hud-help"
        aria-label="Show controls"
      >
        ?
      </button>
      <div id="infobox" class="hud-infobox" data-hud-mode="desktop">
        <div class="hud-title">Race to Treasure Island</div>
        <div class="hud-controls" data-hud-target="desktop">
          <span>← → / A D Steer</span>
          <span>Shift / Space Boost</span>
          <span>Esc / P Pause</span>
        </div>
        <div class="hud-controls" data-hud-target="touch" hidden>
          <span>Tap LEFT / RIGHT</span>
          <span>Hold BOOST</span>
          <span>? for controls</span>
        </div>
      </div>
    </div>

    <!-- Touch controls (overlaid on canvas) -->
    <div id="touch-controls" class="touch-controls">
      <div class="touch-group touch-group--left">
        <button
          id="btn-left"
          class="touch-btn touch-btn--left"
          aria-label="Steer left"
        >
          <span class="touch-btn__arrow">◀</span>
          <span class="touch-btn__label">LEFT</span>
        </button>
        <button
          id="btn-right"
          class="touch-btn touch-btn--right"
          aria-label="Steer right"
        >
          <span class="touch-btn__arrow">▶</span>
          <span class="touch-btn__label">RIGHT</span>
        </button>
      </div>
      <div class="touch-group touch-group--center">
        <button
          id="btn-boost"
          class="touch-btn touch-btn--boost"
          aria-label="Hold to boost"
        >
          <span class="touch-btn__icon">⛵</span>
          <span class="touch-btn__label">BOOST</span>
        </button>
        <button
          id="btn-pause"
          class="touch-btn touch-btn--pause"
          aria-label="Pause"
          aria-pressed="false"
        >
          <span class="touch-btn__icon">⏸</span>
          <span class="touch-btn__label">PAUSE</span>
        </button>
      </div>
      <button
        id="btn-restart"
        class="touch-btn touch-btn--restart"
        aria-label="Restart"
        style="display:none"
      >
        <span class="touch-btn__icon">↻</span>
        <span class="touch-btn__label">RESTART</span>
      </button>
      <div id="touch-mini-hint" class="touch-mini-hint" aria-hidden="true">
        Tap LEFT / RIGHT to steer · Hold BOOST to surge
      </div>
    </div>

    <!-- Touch onboarding hint (first visit) -->
    <div id="touch-hint" class="touch-hint" style="display:none">
      <div class="touch-hint__content">
        <div class="touch-hint__title">How to Play</div>
        <div class="touch-hint__row">
          <span class="touch-hint__key">◀ ▶</span>
          <span class="touch-hint__desc">Steer left &amp; right</span>
        </div>
        <div class="touch-hint__row">
          <span class="touch-hint__key">⛵ HOLD</span>
          <span class="touch-hint__desc">Boost forward</span>
        </div>
        <div class="touch-hint__row">
          <span class="touch-hint__key">⏸</span>
          <span class="touch-hint__desc">Pause the race</span>
        </div>
        <div class="touch-hint__row">
          <span class="touch-hint__key">⇦⇨</span>
          <span class="touch-hint__desc">Steer with keyboard too!</span>
        </div>
        <button id="touch-hint-dismiss" class="touch-hint__dismiss">
          Got it
        </button>
      </div>
    </div>
  </div>
</GamePlayLayout>

<script>
  // @ts-nocheck
  import { createRaceToTreasureIsland } from "../../games/race-to-treasure-island/main";

  const loadingEl = document.getElementById("game-loading");
  const loadingDetailEl = document.getElementById("game-loading-detail");
  const container = document.getElementById("game-container");
  const rotateOverlay = document.getElementById("rotate-overlay");
  const gameShell = document.getElementById("game-shell");

  function updateLoading(text) {
    if (loadingDetailEl) loadingDetailEl.textContent = text;
  }

  updateLoading("Starting Phaser...");

  const urlParams = new URLSearchParams(window.location.search);
  const seed = urlParams.get("seed") || undefined;
  const screenshotMode = urlParams.has("screenshot");
  const testTouchMode = urlParams.has("testTouch");
  const testMode = urlParams.has("testMode");
  // Force canvas renderer in headless environments or when testing to avoid WebGL context loss
  const forceCanvas =
    screenshotMode ||
    urlParams.has("forceCanvas") ||
    navigator.webdriver === true;

  const debugMode =
    testTouchMode ||
    screenshotMode ||
    testMode ||
    forceCanvas ||
    navigator.webdriver === true;

  const game = createRaceToTreasureIsland(
    "game-container",
    seed,
    forceCanvas,
    debugMode,
  );

  // Expose game for test debugging (only in debug mode)
  if (debugMode) {
    (window as any).__paRaceGame = game;
  }
  (window as any).__paRaceDebugMode = debugMode;

  const checkReady = setInterval(() => {
    const canvas = container?.querySelector("canvas");
    if (canvas && canvas.width > 100) {
      clearInterval(checkReady);
      if (loadingEl) loadingEl.classList.add("hidden");
      window.__paBootMetrics = window.__paBootMetrics || {};
      window.__paBootMetrics["game-ready"] = true;
    }
  }, 200);

  setTimeout(() => {
    if (loadingEl) loadingEl.classList.add("hidden");
  }, 10000);

  // ── Rotate overlay logic ──
  function checkOrientation() {
    const isPortrait = window.innerHeight > window.innerWidth;
    const isSmall = window.innerWidth < 768 || window.innerHeight < 500;
    if (isPortrait && isSmall && rotateOverlay && gameShell) {
      rotateOverlay.classList.add("rotate-overlay--visible");
      gameShell.style.display = "none";
    } else if (rotateOverlay && gameShell) {
      rotateOverlay.classList.remove("rotate-overlay--visible");
      gameShell.style.display = "";
    }
  }

  checkOrientation();
  window.addEventListener("resize", checkOrientation);
  window.addEventListener("orientationchange", () => {
    setTimeout(checkOrientation, 300);
  });

  // ── Touch controls (pointer events only — no click fallback) ──
  // iOS Safari has supported Pointer Events since iOS 13.
  // Using only pointer events avoids the click-delay / coords-mismatch
  // issues that plague click-after-touch on mobile Safari.

  const leftBtn = document.getElementById("btn-left");
  const rightBtn = document.getElementById("btn-right");
  const boostBtn = document.getElementById("btn-boost");
  const pauseBtn = document.getElementById("btn-pause");
  const restartBtn = document.getElementById("btn-restart");

  // Global clear for touch input — clears all directional/boost state
  const clearAllTouchInput = () => {
    const input = (window as any).__paTouchInput;
    if (input) {
      input.left = false;
      input.right = false;
      input.boost = false;
    }
    [leftBtn, rightBtn, boostBtn].forEach((b) => {
      if (b) b.classList.remove("touch-btn--active");
    });
  };

  function setupHoldButton(btn, key) {
    if (!btn) return;
    function start(e) {
      e.preventDefault();
      try {
        btn.setPointerCapture(e.pointerId);
      } catch (_) {}
      btn.classList.add("touch-btn--active");
      (window as any).__paTouchInput = (window as any).__paTouchInput || {};
      (window as any).__paTouchInput[key] = true;
    }
    function end(e) {
      e.preventDefault();
      btn.classList.remove("touch-btn--active");
      (window as any).__paTouchInput = (window as any).__paTouchInput || {};
      (window as any).__paTouchInput[key] = false;
    }
    btn.addEventListener("pointerdown", start);
    btn.addEventListener("pointerup", end);
    btn.addEventListener("pointerleave", end);
    btn.addEventListener("pointercancel", end);
    btn.addEventListener("lostpointercapture", end);
  }

  setupHoldButton(leftBtn, "left");
  setupHoldButton(rightBtn, "right");
  setupHoldButton(boostBtn, "boost");

  // Clear touch input on visibility change (e.g. tab switch, phone lock)
  document.addEventListener("visibilitychange", () => {
    if (document.hidden) clearAllTouchInput();
  });

  // Pause: request pause on pointerup (RaceScene toggles actual state and syncs DOM)
  if (pauseBtn) {
    pauseBtn.addEventListener("pointerup", (e) => {
      e.preventDefault();
      clearAllTouchInput();
      (window as any).__paTouchInput = (window as any).__paTouchInput || {};
      (window as any).__paTouchInput.pause = true;
    });
  }

  // Restart: fire on pointerup
  if (restartBtn) {
    restartBtn.addEventListener("pointerup", (e) => {
      e.preventDefault();
      (window as any).__paTouchInput = (window as any).__paTouchInput || {};
      (window as any).__paTouchInput.restart = true;
    });
  }

  // Expose restart button for game state hook
  (window as any).__paRestartBtn = restartBtn;
  // Expose pause button for RaceScene DOM sync
  (window as any).__paPauseBtn = pauseBtn;

  // Initialize overlay hold to false early
  const setOverlayHold = (hold) => {
    if (typeof window !== "undefined") {
      (window as any).__paRaceOverlayHold = hold;
    }
  };
  setOverlayHold(false);

  // Overlay hold helpers
  const showTouchHint = () => {
    if (typeof window !== "undefined") {
      const el = document.getElementById("touch-hint");
      if (el) el.style.display = "flex";
      (window as any).__paRaceOverlayHold = true;
      clearAllTouchInput();
    }
  };

  const hideTouchHint = () => {
    if (typeof window !== "undefined") {
      const el = document.getElementById("touch-hint");
      if (el) el.style.display = "none";
      setOverlayHold(false);
      clearAllTouchInput();
    }
  };

  // Touch onboarding hint logic (runs after DOM ready)
  const initTouchHint = () => {
    if (typeof window === "undefined") return;

    const hintEl = document.getElementById("touch-hint");
    const hintDismiss = document.getElementById("touch-hint-dismiss");

    // First-visit hint: show on coarse-pointer, non-debug, non-screenshot
    // Allow forcing via ?forceHint=1 for testing
    const forceHint = new URLSearchParams(window.location.search).has(
      "forceHint",
    );
    if (
      hintEl &&
      !screenshotMode &&
      (!debugMode || forceHint) &&
      (navigator.maxTouchPoints > 0 ||
        window.matchMedia("(pointer: coarse)").matches ||
        window.matchMedia("(any-pointer: coarse)").matches)
    ) {
      const shown = sessionStorage.getItem("pa-race-hint-shown");
      if (!shown) {
        showTouchHint();
        sessionStorage.setItem("pa-race-hint-shown", "1");
        // Auto-dismiss after 6 seconds
        setTimeout(() => {
          hideTouchHint();
        }, 6000);
      }
    }

    if (hintDismiss) {
      hintDismiss.addEventListener("pointerup", (e) => {
        e.preventDefault();
        hideTouchHint();
      });
    }

    // Help button: reopen controls hint
    const helpBtn = document.getElementById("touch-help-button");
    if (helpBtn) {
      helpBtn.addEventListener("pointerup", (e) => {
        e.preventDefault();
        showTouchHint();
      });
    }
  };

  // ── Screenshot mode: hide overlays ──
  if (screenshotMode) {
    const hud = document.getElementById("hud-overlay");
    if (hud) hud.style.display = "none";
    const tc = document.getElementById("touch-controls");
    if (tc) tc.style.display = "none";
    const mh = document.getElementById("touch-mini-hint");
    if (mh) mh.style.display = "none";
    document.documentElement.classList.add("pa-screenshot-mode");
    hideTouchHint();
  }

  // ── Test touch mode: force touch controls visible ──
  const applyHudMode = (mode) => {
    const infobox = document.getElementById("infobox");
    if (!infobox) return;
    infobox.dataset.hudMode = mode;
    const desktopControls = infobox.querySelector(
      '[data-hud-target="desktop"]',
    );
    const touchControls = infobox.querySelector('[data-hud-target="touch"]');
    if (desktopControls) {
      desktopControls.hidden = mode !== "desktop";
      desktopControls.style.removeProperty("display");
    }
    if (touchControls) {
      touchControls.hidden = mode !== "touch";
      touchControls.style.removeProperty("display");
    }
  };

  const initHud = () => {
    // Initialize overlay hold to false
    setOverlayHold(false);

    // Initialize touch hint logic
    initTouchHint();

    // ── Test touch mode: force touch controls visible ──
    if (testTouchMode) {
      document.documentElement.classList.add("pa-force-touch-controls");
      const tc = document.getElementById("touch-controls");
      if (tc) tc.style.display = "flex";
      applyHudMode("touch");
    }

    // ── Touch-capable detection: show controls on touch-capable devices ──
    const isTouchCapable =
      navigator.maxTouchPoints > 0 ||
      window.matchMedia("(any-pointer: coarse)").matches;
    if (isTouchCapable && !testTouchMode) {
      document.documentElement.classList.add("pa-touch-capable");
      applyHudMode("touch");
    }
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initHud);
  } else {
    initHud();
  }
</script>

<style is:global>
  /* ── Rotate overlay ── */
  .rotate-overlay {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: #0a1628;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    text-align: center;
    padding: 2rem;
    box-sizing: border-box;
  }
  .rotate-overlay--visible {
    display: flex;
  }
  .rotate-overlay__icon {
    font-size: 64px;
    color: #ffd700;
    margin-bottom: 1rem;
    animation: rotate-hint 2s ease-in-out infinite;
  }
  @keyframes rotate-hint {
    0%,
    100% {
      transform: rotate(0deg);
    }
    50% {
      transform: rotate(90deg);
    }
  }
  .rotate-overlay__title {
    font-family: monospace;
    font-size: 20px;
    color: #ffd700;
    margin: 0 0 0.5rem;
  }
  .rotate-overlay__text {
    font-family: monospace;
    font-size: 13px;
    color: #888;
    max-width: 300px;
    margin: 0 0 1.5rem;
  }
  .rotate-overlay__back {
    font-family: monospace;
    font-size: 12px;
    color: #666;
    text-decoration: none;
    padding: 0.5rem 1rem;
    border: 1px solid #444;
    border-radius: 4px;
  }
  .rotate-overlay__back:hover {
    color: #ffd700;
    border-color: #ffd700;
  }

  /* ── Game shell ── */
  .game-shell {
    position: relative;
    width: 100%;
    height: 100vh;
    height: 100svh;
    height: 100dvh;
    background: #0a1628;
    overflow: hidden;
  }

  /* ── Game container (fills shell, Phaser handles aspect ratio) ── */
  .game-container {
    width: 100%;
    height: 100%;
    position: absolute;
    inset: 0;
  }
  .game-container canvas {
    display: block;
  }

  /* ── Loading overlay ── */
  .game-loading {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: #0a1628;
    z-index: 100;
    gap: 1rem;
    transition: opacity 0.5s;
  }
  .game-loading.hidden {
    opacity: 0;
    pointer-events: none;
  }
  .loader-spinner {
    width: 40px;
    height: 40px;
    border: 3px solid #333;
    border-top-color: #ffd700;
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
  }
  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }
  .loader-text {
    font-family: monospace;
    font-size: 14px;
    color: #ffd700;
  }
  .loader-detail {
    font-family: monospace;
    font-size: 11px;
    color: #888;
  }

  /* ── HUD overlay (top bar, behind touch controls z-order) ── */
  .hud-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    padding: 0.5rem 0.75rem;
    padding-top: max(0.5rem, env(safe-area-inset-top));
    pointer-events: none;
    z-index: 50;
  }
  .hud-overlay > * {
    pointer-events: auto;
  }
  .hud-back {
    font-family: monospace;
    font-size: 11px;
    color: #888;
    text-decoration: none;
    padding: 0.3rem 0.6rem;
    border: 1px solid #444;
    border-radius: 4px;
    background: rgba(0, 0, 0, 0.6);
  }
  .hud-back:hover {
    color: #ffd700;
    border-color: #ffd700;
  }
  .hud-help {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border: 1px solid rgba(255, 215, 0, 0.4);
    border-radius: 6px;
    background: rgba(0, 0, 0, 0.5);
    color: #ffd700;
    font-family: monospace;
    font-size: 14px;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
    transition:
      background 0.15s,
      border-color 0.15s;
  }
  .hud-help:hover {
    background: rgba(255, 215, 0, 0.15);
    border-color: #ffd700;
  }
  @media (hover: hover) and (pointer: fine) {
    .hud-help {
      display: none;
    }
  }
  @media (pointer: fine) {
    .hud-help {
      display: none;
    }
  }
  .pa-touch-capable .hud-help,
  .pa-force-touch-controls .hud-help {
    display: flex;
  }
  .hud-infobox {
    font-family: monospace;
    font-size: 10px;
    color: #888;
    background: rgba(0, 0, 0, 0.6);
    padding: 0.4rem 0.7rem;
    border-radius: 4px;
    border: 1px solid #333;
    text-align: right;
  }
  .hud-title {
    color: #ffd700;
    font-size: 11px;
    margin-bottom: 0.25rem;
  }
  .hud-controls {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }
  .hud-controls[data-hud-target="desktop"] {
    display: flex;
  }
  .hud-controls[data-hud-target="touch"] {
    display: flex;
  }
  /* Visibility controlled by hidden attribute */
  /* Screenshot mode: always show desktop */
  .pa-screenshot-mode .hud-controls[data-hud-target="desktop"] {
    display: flex !important;
  }
  .pa-screenshot-mode .hud-controls[data-hud-target="touch"] {
    display: none !important;
  }
  /* Ensure hidden attribute works */
  [hidden] {
    display: none !important;
  }

  /* Compact touch HUD for small landscape screens */
  @media (max-height: 430px) {
    .pa-touch-capable .hud-infobox,
    .pa-force-touch-controls .hud-infobox {
      max-width: 210px;
      font-size: 9px;
      padding: 0.35rem 0.5rem;
    }
    .pa-touch-capable .hud-title,
    .pa-force-touch-controls .hud-title {
      display: none;
    }
    .pa-touch-capable .hud-overlay,
    .pa-force-touch-controls .hud-overlay {
      gap: 0.35rem;
    }
    .hud-infobox[data-hud-mode="touch"] .hud-controls[data-hud-target="touch"],
    .hud-infobox[data-hud-mode="touch"]
      .hud-controls[data-hud-target="touch"]
      span {
      font-size: 9px;
      gap: 0.05rem;
    }
  }

  /* ── Touch controls (overlaid on canvas, bottom area) ── */
  .touch-controls {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    padding: 0.5rem 0.75rem;
    padding-bottom: max(0.5rem, env(safe-area-inset-bottom, 0.5rem));
    z-index: 60;
    pointer-events: none;
    gap: 0.5rem;
  }
  .touch-controls > * {
    pointer-events: auto;
  }

  .touch-group {
    display: flex;
    gap: 0.5rem;
    align-items: flex-end;
  }

  .touch-btn {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.1rem;
    border: 2px solid rgba(255, 255, 255, 0.25);
    border-radius: 12px;
    background: rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    color: #ddd;
    font-family: monospace;
    font-size: 10px;
    padding: 0;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    touch-action: none;
    transition:
      background 0.08s,
      border-color 0.08s,
      transform 0.08s;
    user-select: none;
    -webkit-user-select: none;
    min-width: 60px;
    min-height: 52px;
  }

  .touch-btn--left,
  .touch-btn--right {
    width: 68px;
    height: 56px;
    border-color: rgba(68, 136, 255, 0.5);
  }
  .touch-btn--left .touch-btn__arrow,
  .touch-btn--right .touch-btn__arrow {
    font-size: 22px;
    line-height: 1;
  }
  .touch-btn--left .touch-btn__label,
  .touch-btn--right .touch-btn__label {
    font-size: 8px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    opacity: 0.7;
  }

  .touch-btn--boost {
    width: 80px;
    height: 56px;
    border-color: rgba(255, 136, 0, 0.5);
  }
  .touch-btn--boost .touch-btn__icon {
    font-size: 20px;
    line-height: 1;
  }
  .touch-btn--boost .touch-btn__label {
    font-size: 8px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    opacity: 0.7;
  }

  .touch-btn--pause {
    width: 52px;
    height: 52px;
    border-color: rgba(255, 255, 255, 0.2);
    background: rgba(0, 0, 0, 0.4);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
  }
  .touch-btn--pause .touch-btn__icon {
    font-size: 18px;
    line-height: 1;
  }
  .touch-btn--pause .touch-btn__label {
    font-size: 7px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    opacity: 0.6;
    margin-top: 1px;
  }

  .touch-btn--restart {
    position: absolute;
    left: 50%;
