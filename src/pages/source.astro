---
import BaseLayout from "../layouts/BaseLayout.astro";
import CTAButton from "../components/CTAButton.astro";
import ToolingTable from "../components/ToolingTable.astro";
import ModelObservations from "../components/ModelObservations.astro";
import { site } from "../data/profile";
import { webPageNode } from "../lib/schema";
import { publicDomainArt } from "../data/publicDomainArt";
---

<BaseLayout
  title="Source"
  description="Source code, releases, and roadmap for Pirate Arcade."
  current="source"
  jsonLd={[
    webPageNode(
      "/source/",
      "Source Code and Releases — Pirate Arcade",
      "Source code, releases, and roadmap for Pirate Arcade.",
      "WebPage",
    ),
  ]}
>
  <section class="section">
    <div class="section__header">
      <p class="section__eyebrow">Code &amp; Releases</p>
      <h1 class="section__title">Source &amp; Roadmap</h1>
      <p class="section__description">
        All code is open source under the MIT license. Contributions, issues,
        and feature requests are welcome.
      </p>
    </div>

    <ul class="source-list">
      <li class="source-list__item">
        <div class="source-list__item-badges">
          <img
            src="https://img.shields.io/github/actions/workflow/status/edonahue/pirate-arcade/ci.yml?label=desktop+CI&style=flat-square"
            alt="Desktop CI status"
          />
          <img
            src="https://img.shields.io/github/v/release/edonahue/pirate-arcade?style=flat-square&label=release"
            alt="Latest release"
          />
        </div>
        <h2 class="source-list__item-title">Desktop Game Repository</h2>
        <p class="source-list__item-description">
          Python + Pygame arcade collection. Four desktop games with procedural
          audio, high score tracking, Port Royale save/load, cross-platform
          packaging, and full CI.
        </p>
        <a
          href="https://github.com/edonahue/pirate-arcade"
          target="_blank"
          rel="noopener noreferrer"
          class="source-list__item-link"
        >
          github.com/edonahue/pirate-arcade
        </a>
      </li>

      <li class="source-list__item">
        <div class="source-list__item-badges">
          <img
            src="https://img.shields.io/github/actions/workflow/status/edonahue/pirate-arcade-web/ci.yml?label=website+CI&style=flat-square"
            alt="Website CI status"
          />
          <img
            src="https://img.shields.io/github/v/release/edonahue/pirate-arcade-web?style=flat-square&label=release"
            alt="Latest website release"
          />
        </div>
        <h2 class="source-list__item-title">Website Repository</h2>
        <p class="source-list__item-description">
          This site: Astro, TypeScript, vanilla CSS, deployed to Cloudflare
          Pages free tier.
        </p>
        <a
          href="https://github.com/edonahue/pirate-arcade-web"
          target="_blank"
          rel="noopener noreferrer"
          class="source-list__item-link"
        >
          github.com/edonahue/pirate-arcade-web
        </a>
      </li>

      <li class="source-list__item">
        <h2 class="source-list__item-title">Releases</h2>
        <p class="source-list__item-description">
          Download the latest desktop builds. Windows: standalone .exe. Linux:
          Debian .deb package. macOS: build from source.
        </p>
        <a
          href="https://github.com/edonahue/pirate-arcade/releases"
          target="_blank"
          rel="noopener noreferrer"
          class="source-list__item-link"
        >
          github.com/edonahue/pirate-arcade/releases
        </a>
      </li>

      <li class="source-list__item">
        <h2 class="source-list__item-title">Issues &amp; Roadmap</h2>
        <p class="source-list__item-description">
          Bug reports, feature requests, and planned work. Check the ROADMAP in
          the repo for current priorities.
        </p>
        <a
          href="https://github.com/edonahue/pirate-arcade/issues"
          target="_blank"
          rel="noopener noreferrer"
          class="source-list__item-link"
        >
          github.com/edonahue/pirate-arcade/issues
        </a>
      </li>
    </ul>

    <div class="text-center mt-2">
      <CTAButton
        href="https://github.com/edonahue/pirate-arcade"
        variant="primary"
      >
        View on GitHub
      </CTAButton>
    </div>
  </section>

  <section class="section">
    <div class="section__header">
      <p class="section__eyebrow">Experiment</p>
      <h2 class="section__title">AI Development Stack</h2>
      <p class="section__description">
        Every tool used to build this project was free-to-use: open-source
        frameworks, free-tier cloud services, and local hardware. No paid AI
        models, no cloud compute, no subscriptions. The project now includes a
        web-native Phaser 3 game alongside the Pygbag/WebAssembly ports.
      </p>
    </div>

    <ToolingTable />

    <div class="section__header mt-4">
      <h2 class="section__title">Model Run Observations</h2>
      <p class="section__description">
        Notes on what each model was asked to generate and how well it
        performed. These are session notes, not benchmarks.
      </p>
    </div>

    <ModelObservations />

    <p class="text-center mt-2" style="font-size:0.8125rem;color:var(--muted);">
      See the
      <a
        href="https://github.com/edonahue/pirate-arcade/blob/main/EXPERIMENT.md"
        target="_blank"
        rel="noopener noreferrer">full experiment log</a
      >
      in the desktop repo for the complete methodology and desktop-game-specific notes.
    </p>
  </section>

  <section class="section">
    <div class="section__header">
      <p class="section__eyebrow">Documentation</p>
      <h2 class="section__title">Project Docs</h2>
      <p class="section__description">
        Detailed documentation for the experiment methodology, asset inventory,
        deployment, and roadmap.
      </p>
    </div>

    <ul class="source-list">
      <li class="source-list__item">
        <h2 class="source-list__item-title">Build Log</h2>
        <p class="source-list__item-description">
          Development journal covering the experiment, methodology,
          infrastructure, and browser port feasibility.
        </p>
        <a href="/build-log" class="source-list__item-link"> /build-log </a>
      </li>

      <li class="source-list__item">
        <h2 class="source-list__item-title">Free AI Coding Experiment</h2>
        <p class="source-list__item-description">
          Tooling inventory, model run observations, and methodology for the
          zero-cost AI-assisted development experiment.
        </p>
        <a
          href="https://github.com/edonahue/pirate-arcade/blob/main/EXPERIMENT.md"
          target="_blank"
          rel="noopener noreferrer"
          class="source-list__item-link"
        >
          EXPERIMENT.md
        </a>
      </li>

      <li class="source-list__item">
        <h2 class="source-list__item-title">Asset Inventory</h2>
        <p class="source-list__item-description">
          Current state of all visual assets: screenshots, icons, OG image, and
          desktop game assets.
        </p>
        <a
          href="https://github.com/edonahue/pirate-arcade-web/blob/main/ASSETS.md"
          target="_blank"
          rel="noopener noreferrer"
          class="source-list__item-link"
        >
          ASSETS.md
        </a>
      </li>

      <li class="source-list__item">
        <h2 class="source-list__item-title">Roadmap</h2>
        <p class="source-list__item-description">
          Current development roadmap: completed phases, in-progress work, and
          planned features.
        </p>
        <a
          href="https://github.com/edonahue/pirate-arcade-web/blob/main/ROADMAP.md"
          target="_blank"
          rel="noopener noreferrer"
          class="source-list__item-link"
        >
          ROADMAP.md
        </a>
      </li>

      <li class="source-list__item">
        <h2 class="source-list__item-title">Deployment Guide</h2>
        <p class="source-list__item-description">
          Cloudflare Pages setup, domain configuration, and deployment workflow.
        </p>
        <a
          href="https://github.com/edonahue/pirate-arcade-web/blob/main/DEPLOYMENT.md"
          target="_blank"
          rel="noopener noreferrer"
          class="source-list__item-link"
        >
          DEPLOYMENT.md
        </a>
      </li>
    </ul>
  </section>

  <section class="section">
    <div class="section__header">
      <p class="section__eyebrow">Art &amp; Attribution</p>
      <h2 class="section__title">Public-Domain Illustrations</h2>
      <p class="section__description">
        This site uses public-domain pirate and Treasure Island illustrations by
        Howard Pyle (1853–1911) and Louis Rhead (1857–1926). Howard Pyle's
        illustrations are from <em>Howard Pyle's Book of Pirates</em> (1921). Louis
        Rhead's illustration is from the 1915 edition of
        <em>Treasure Island</em> by Robert Louis Stevenson (Project Gutenberg). All
        are public domain in the United States. See
        <a href="/credits">the Credits page</a>
        for the full breakdown or
        <a
          href="https://github.com/edonahue/pirate-arcade-web/blob/main/ASSET_CREDITS.md"
          target="_blank"
          rel="noopener noreferrer">ASSET_CREDITS.md</a
        >
        for the complete inventory.
      </p>
    </div>

    <div class="art-provenance-grid">
      {
        publicDomainArt.map((art) => (
          <article class="art-provenance-card">
            <img
              src={`/images/art/${art.filename}`}
              alt={art.alt}
              width={art.width}
              height={art.height}
              loading="lazy"
              class="art-provenance__image"
            />
            <div class="art-provenance__meta">
              <h3 class="art-provenance__title">{art.title}</h3>
              <p class="art-provenance__desc">{art.alt}</p>
              <dl class="art-provenance__details">
                <dt>Author</dt>
                <dd>{art.author}</dd>
                <dt>Year</dt>
                <dd>{art.year}</dd>
                <dt>Collection</dt>
                <dd>{art.collection}</dd>
                <dt>License</dt>
                <dd>{art.license}</dd>
                <dt>Source</dt>
                <dd>
                  <a
                    href={art.sourcePage}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {art.sourcePage.includes("wikimedia.org")
                      ? "Wikimedia Commons"
                      : art.sourcePage.includes("gutenberg.org")
                        ? "Project Gutenberg"
                        : "Source"}
                  </a>
                </dd>
              </dl>
            </div>
          </article>
        ))
      }
    </div>

    <p class="art-provenance__note">
      All images are optimized WebP conversions of the original public-domain
      scans. They are used decoratively on this site (hero backgrounds, section
      accents) with <code>aria-hidden="true"</code> or empty alt where appropriate.
    </p>
  </section>

  <section class="section section--pyle">
    <div class="section__header">
      <p class="section__eyebrow">Maker</p>
      <h2 class="section__title">Built by {site.author}</h2>
      <p class="section__description">
        {site.authorDescription} This project is my public workbench for exploring
        zero-cost AI-assisted development.
      </p>
    </div>

    <div class="maker-card">
      <div class="maker-card__links">
        <a
          href={site.personalSiteUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="maker-card__link"
        >
          erichdonahue.com
        </a>
        <a
          href={site.githubUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="maker-card__link"
        >
          github/edonahue
        </a>
        <a
          href={site.buyMeACoffeeUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="maker-card__link maker-card__link--muted"
        >
          Buy me a coffee
        </a>
      </div>
    </div>

    <img
      class="section__art"
      src="/images/art/pyle-marooned.webp"
      alt=""
      aria-hidden="true"
      decoding="async"
      loading="lazy"
    />
  </section>
</BaseLayout>
